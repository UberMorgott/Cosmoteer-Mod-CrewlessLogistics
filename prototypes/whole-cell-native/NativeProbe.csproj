<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>CrewlessLogistics.NativeProbe</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CrewlessLogistics.NativeProbe.Tests" />
    <!-- Device sockets are added by the belts DLL (NetworkCoverage); copied next to the probe, reached by reflection. -->
    <ProjectReference Include="..\..\belts\CrewlessLogistics.Belts.csproj" ReferenceOutputAssembly="false" OutputItemType="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
