<Project Sdk="Microsoft.NET.Sdk">
  <!--
    C# belt sim for Crewless Logistics (docs/BELTS_DESIGN.md). Loaded by Yet Another Mod Loader (workshop 3577650065).
    Game runs on net10.0 (Bin\Cosmoteer.runtimeconfig.json), so the mod targets net10.0 too (as MiningDrone c92a93d).
    Compiles against publicized game assemblies in lib\ (gitignored, regenerated from the installed game; needs the
    global tool: dotnet tool install -g BepInEx.AssemblyPublicizer.Cli). Game binaries are never committed (*.dll ignored).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CrewlessLogistics.Belts</AssemblyName>
    <RootNamespace>CrewlessLogistics.Belts</RootNamespace>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <GameBin>D:\Steam\steamapps\common\Cosmoteer\Bin</GameBin>
    <ModLoaderDir>D:\Steam\steamapps\workshop\content\799600\3577650065</ModLoaderDir>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;probe-mod\**</DefaultItemExcludes>
  </PropertyGroup>

  <Target Name="PublicizeGameAssemblies" BeforeTargets="ResolveAssemblyReferences"
          Inputs="$(GameBin)\Cosmoteer.dll;$(GameBin)\HalflingCore.dll"
          Outputs="lib\Cosmoteer.dll;lib\HalflingCore.dll">
    <Exec Command="assembly-publicizer &quot;$(GameBin)\Cosmoteer.dll&quot; &quot;$(GameBin)\HalflingCore.dll&quot; --strip -f -o &quot;$(MSBuildProjectDirectory)\lib&quot;"
          EnvironmentVariables="DOTNET_ROLL_FORWARD=Major" />
  </Target>

  <ItemGroup>
    <Reference Include="Cosmoteer">
      <HintPath>lib\Cosmoteer.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HalflingCore">
      <HintPath>lib\HalflingCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Loader-shipped Harmony; never copied: the loader accepts only its own build (MVID dc2e7251-...). -->
    <Reference Include="0Harmony">
      <HintPath>$(ModLoaderDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
