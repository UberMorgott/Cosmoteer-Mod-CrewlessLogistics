CrewlessLogistics
{
    HeatCrossingName = "Croisement chaleur/électricité Crewless Logistics"
    HeatCrossingDesc = "Un conduit thermique orange sur un axe, un câble électrique bleu sur l'autre. Faites pivoter la pièce pour échanger les axes. Bloque le passage de l'équipage. Disponible dans Alimentation et Gestion de la chaleur. Habillage sombre purement visuel ; caractéristiques d'un conduit thermique standard : 1000 PV, densité 1, aucune catégorie de blindage ni absorption des IEM. Coût : 4 bobines et 2 unités d'acier."
    NetworkOff = "Réseau électrique : DÉSACTIVÉ. Cliquez pour raccorder ce module aux câbles. Désactivé par défaut ; l'état est mémorisé. L'énergie stockée est conservée. Le fonctionnement normal et le transport par l'équipage ne changent pas."
    NetworkOn = "Réseau électrique : ACTIVÉ. Cliquez pour déconnecter ce module des câbles. L'état est mémorisé. Activez l'interrupteur sur chaque module à raccorder. La surcharge se règle séparément."
    CableName = "Câble électrique Crewless Logistics"
    CableDesc = "Quatre raccordements électriques automatiques ; transfère uniquement des batteries entières. Ne se raccorde pas aux conduits thermiques. Bloque le passage de l'équipage. Le voyant vert s'allume quand une source raccordée contient une batterie entière. Vu de l'extérieur, le câble est recouvert d'une coque ordinaire. Habillage sombre purement visuel ; caractéristiques d'un conduit thermique standard : 1000 PV, densité 1, aucune catégorie de blindage ni absorption des IEM. Coût : 4 bobines et 2 unités d'acier."
    CrossingName = "Passage d'équipage Crewless Logistics"
    CrossingDesc = "Deux raccordements électriques opposés ; permet le passage de l'équipage. L'équipage passe perpendiculairement au câble à 80 % de sa vitesse. Faites pivoter la pièce pour choisir la direction. Le voyant vert indique qu'une source raccordée contient une batterie entière. Transfère uniquement des batteries entières ; ne se raccorde pas aux conduits thermiques. Habillage sombre purement visuel ; caractéristiques d'un conduit thermique standard : 1000 PV, densité 1, aucune catégorie de blindage ni absorption des IEM. Coût : 4 bobines et 2 unités d'acier."
    BeltName = "Crewless Logistics : tapis roulant"
    BeltDesc = "Transporte toute ressource empilable sur deux voies à 2 cases/s, jusqu'à 4 objets par voie et par case. Tourne tout seul quand il est alimenté par un seul côté ; un tapis qui arrive sur le côté d'une ligne droite dépose ses objets sur la voie proche. L'équipage peut marcher dessus. Pivotez pour choisir le sens. Nécessite la bibliothèque Yet Another Mod Loader ; sans elle, le tapis n'est qu'un sol. Coûte 4 acier + 2 bobines."
    SplitterName = "Crewless Logistics : répartiteur de tapis"
    SplitterDesc = "1x2. Deux entrées à l'arrière, deux sorties à l'avant. Les objets alternent entre les sorties voie par voie ; si une sortie est bloquée ou absente, tout part vers l'autre, il fusionne donc aussi deux tapis. Les voies sont conservées. Réglages : priorité d'entrée, priorité de sortie (gauche/droite dans le sens de marche) et un filtre de ressource dont les objets vont du côté de la priorité de sortie (à gauche sans priorité), tous les autres de l'autre côté. Coûte 8 acier + 4 bobines."
    ConnectorName = "Crewless Logistics : connecteur de tapis"
    ConnectorDesc = "Déplace la ressource choisie des cases derrière et à côté de la flèche (plusieurs salles alternent) vers la case devant : salle vers tapis, tapis vers salle, salle vers salle ou tapis vers tapis. Fonctionne avec les soutes, usines et armes, jamais avec le réseau électrique. Choisissez la ressource avec le bouton de filtre ; la valeur par défaut Auto déplace la seule ressource utilisable par les deux voisins, sinon rien ; Aucun l'arrête. La priorité de source (arrière/gauche/droite) prend d'abord de ce côté, des autres seulement s'il n'a rien ; par défaut elles alternent. Aucune énergie requise. Coûte 4 acier + 2 bobines."
    BeltCrossingName = "Crewless Logistics : croisement de tapis"
    BeltCrossingDesc = "Un tapis roulant droit passe au-dessus d'un caloduc ou d'un câble électrique et s'adapte à ce qui le croise : les objets circulent sur un axe, la chaleur ou les batteries entières sur l'autre (les caloducs ne se raccordent qu'aux caloducs, les câbles qu'aux câbles). Faites pivoter pour choisir le sens du tapis. Il ne tourne jamais ; un tapis qui l'alimente par le côté dépose ses objets sur la voie proche. L'équipage peut marcher le long du tapis à 70 % de vitesse. Statistiques du croisement de caloduc normal : 1000 PV, densité 1. Le tapis nécessite la bibliothèque Yet Another Mod Loader. Coûte 4 acier + 2 bobines."
    FilterAuto = "Filtre du tapis : Auto. Laisse passer la seule ressource acceptée par les voisins ; sinon rien. Choisissez une ressource, N'importe laquelle ou Aucun."
    FilterNone = "Filtre du tapis : Aucun. Arrêté, rien ne passe."
    FilterAny = "Filtre du tapis : n'importe quelle ressource."
    SplitterFilterNone = "Filtre du répartiteur : aucun. Les objets ne sont pas triés par ressource."
    InputPriorityNone = "Priorité d'entrée : aucune. Les deux entrées sont utilisées."
    InputPriorityLeft = "Priorité d'entrée : gauche. L'entrée gauche d'abord ; la droite seulement quand la gauche n'apporte rien."
    InputPriorityRight = "Priorité d'entrée : droite. L'entrée droite d'abord ; la gauche seulement quand la droite n'apporte rien."
    OutputPriorityNone = "Priorité de sortie : aucune. Les objets alternent entre les deux sorties."
    OutputPriorityLeft = "Priorité de sortie : gauche. Tout part à gauche ; la droite ne prend que ce que la gauche refuse."
    OutputPriorityRight = "Priorité de sortie : droite. Tout part à droite ; la gauche ne prend que ce que la droite refuse."
    SourcePriorityRoundRobin = "Priorité de source : alternée. Les sources arrière et latérales alternent."
    SourcePriorityBack = "Priorité de source : arrière. Prend d'abord derrière ; les côtés seulement si l'arrière n'a rien."
    SourcePriorityLeft = "Priorité de source : gauche. Prend d'abord à gauche ; les autres seulement si la gauche n'a rien."
    SourcePriorityRight = "Priorité de source : droite. Prend d'abord à droite ; les autres seulement si la droite n'a rien."
}
