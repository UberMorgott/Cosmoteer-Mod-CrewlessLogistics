CrewlessLogistics
{
    HeatCrossingName = "Croisement chaleur/électricité Crewless Logistics"
    HeatCrossingDesc = "Un conduit thermique orange sur un axe, un câble électrique bleu sur l'autre. Faites pivoter la pièce pour échanger les axes. Bloque le passage de l'équipage. Disponible dans Alimentation et Gestion de la chaleur. Habillage sombre purement visuel ; caractéristiques d'un conduit thermique standard : 1000 PV, densité 1, aucune catégorie de blindage ni absorption des IEM. Coût : 4 bobines et 2 unités d'acier."
    NetworkOff = "Réseau électrique : DÉSACTIVÉ. Cliquez pour raccorder ce module aux câbles. Désactivé par défaut ; l'état est mémorisé. L'énergie stockée est conservée. Le fonctionnement normal et le transport par l'équipage ne changent pas."
    NetworkOn = "Réseau électrique : ACTIVÉ. Cliquez pour déconnecter ce module des câbles. L'état est mémorisé. Activez l'interrupteur sur chaque module à raccorder. La surcharge se règle séparément."
    CableName = "Câble électrique Crewless Logistics"
    CableDesc = "Quatre raccordements électriques automatiques ; transfère uniquement des batteries entières. Ne se raccorde pas aux conduits thermiques. Bloque le passage de l'équipage. Le voyant vert s'allume quand une source raccordée contient une batterie entière. Vu de l'extérieur, le câble est recouvert d'une coque ordinaire. Habillage sombre purement visuel ; caractéristiques d'un conduit thermique standard : 1000 PV, densité 1, aucune catégorie de blindage ni absorption des IEM. Coût : 4 bobines et 2 unités d'acier."
    CrossingName = "Passage d'équipage Crewless Logistics"
    CrossingDesc = "Deux raccordements électriques opposés ; permet le passage de l'équipage. L'équipage passe perpendiculairement au câble à 80 % de sa vitesse. Faites pivoter la pièce pour choisir la direction. Le voyant vert indique qu'une source raccordée contient une batterie entière. Transfère uniquement des batteries entières ; ne se raccorde pas aux conduits thermiques. Habillage sombre purement visuel ; caractéristiques d'un conduit thermique standard : 1000 PV, densité 1, aucune catégorie de blindage ni absorption des IEM. Coût : 4 bobines et 2 unités d'acier."
    AmmoBeltName = "Bande de munitions Crewless"
    AmmoBeltDesc = "Prototype. Déplace balles et pièces de missile IEM case par case sans équipage : entrée à l'arrière, sortie côté flèche. Prélève à la sortie d'une usine de munitions ou d'IEM située derrière et alimente la bande suivante, un canon (balles) ou un lance-missiles en mode IEM (pièces IEM). Une munition par type et par case. Statistiques de caloduc : 1000 PV, 4 acier + 2 bobines."
    AmmoBeltCornerLeftName = "Coude de bande de munitions Crewless (gauche)"
    AmmoBeltCornerLeftDesc = "Prototype. Bande qui tourne à gauche : entrée à l'arrière, sortie à gauche. Prélève à la sortie d'une usine située derrière. Statistiques de caloduc : 1000 PV, 4 acier + 2 bobines."
    AmmoBeltCornerRightName = "Coude de bande de munitions Crewless (droite)"
    AmmoBeltCornerRightDesc = "Prototype. Bande qui tourne à droite : entrée à l'arrière, sortie à droite. Prélève à la sortie d'une usine située derrière. Statistiques de caloduc : 1000 PV, 4 acier + 2 bobines."
    AmmoBeltMergerName = "Jonction de bandes de munitions Crewless"
    AmmoBeltMergerDesc = "Prototype. Réunit des bandes : reçoit par l'arrière, la gauche et la droite ; sortie côté flèche. Statistiques de caloduc : 1000 PV, 4 acier + 2 bobines."
    AmmoBeltSplitterName = "Répartiteur de bandes de munitions Crewless"
    AmmoBeltSplitterDesc = "Prototype. Entrée à l'arrière ; répartit à tour de rôle vers l'avant, la gauche et la droite en sautant les sorties pleines ou bloquées. Six interrupteurs choisissent quelle munition sort de quel côté. Statistiques de caloduc : 1000 PV, 4 acier + 2 bobines."
    FilterBulletFront = "Répartiteur : balles vers la sortie avant. Clair = autorisé, sombre = bloqué. Cliquez pour basculer ; enregistré."
    FilterBulletLeft = "Répartiteur : balles vers la sortie gauche. Clair = autorisé, sombre = bloqué. Cliquez pour basculer ; enregistré."
    FilterBulletRight = "Répartiteur : balles vers la sortie droite. Clair = autorisé, sombre = bloqué. Cliquez pour basculer ; enregistré."
    FilterEmpFront = "Répartiteur : pièces de missile IEM vers la sortie avant. Clair = autorisé, sombre = bloqué. Cliquez pour basculer ; enregistré."
    FilterEmpLeft = "Répartiteur : pièces de missile IEM vers la sortie gauche. Clair = autorisé, sombre = bloqué. Cliquez pour basculer ; enregistré."
    FilterEmpRight = "Répartiteur : pièces de missile IEM vers la sortie droite. Clair = autorisé, sombre = bloqué. Cliquez pour basculer ; enregistré."
}
