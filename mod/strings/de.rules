CrewlessLogistics
{
    HeatCrossingName = "Crewless Logistics Wärme-/Stromkreuzung"
    HeatCrossingDesc = "Ein orangefarbenes Wärmerohr kreuzt ein blaues Stromkabel. Wärme und Strom fließen unabhängig entlang verschiedener Achsen; Drehen vertauscht die Achsen. Verfügbar unter Energie und Wärmeregulierung. Für die Crew nicht passierbar. Dunkle Verkleidung ohne Schutzwirkung: Werte eines normalen Wärmerohrs, 1000 HP, Dichte 1, keine Panzerungskategorie, keine EMP-Absorption. Kosten: 4 Spulen + 2 Stahl."
    NetworkOff = "Stromnetz: AUS. Klicken, um dieses Gerät mit den Kabeln zu verbinden. Standardmäßig aus; die Einstellung wird gespeichert. Gespeicherte Energie bleibt erhalten. Der normale Betrieb und die Versorgung durch die Crew funktionieren weiterhin."
    NetworkOn = "Stromnetz: EIN. Klicken, um dieses Gerät von den Kabeln zu trennen. Die Einstellung wird gespeichert. Jedes Gerät braucht einen eingeschalteten eigenen Schalter, auch Schubdüsen, die von einem Maschinenraum versorgt werden. Die Übertaktung wird unabhängig davon geschaltet."
    CableName = "Crewless Logistics Stromkabel"
    CableDesc = "Stromkabel mit dunklem Metallgehäuse und schlichtem Rumpfdach. Vier automatische Stromanschlüsse. Überträgt nur ganze Batterien. Das grüne Glas unter dem Gitter leuchtet, wenn eine verbundene Quelle mindestens eine ganze Batterie hat. Verbindet sich nicht mit Wärmerohren. Für die Crew nicht passierbar. Die Verkleidung ist rein optisch: Werte eines normalen Wärmerohrs, 1000 HP, Dichte 1, keine Panzerungskategorie, keine EMP-Absorption. Kosten: 4 Spulen + 2 Stahl."
    CrossingName = "Crewless Logistics Crew-Übergang"
    CrossingDesc = "Begehbare Kabelkreuzung mit zwei gegenüberliegenden Stromanschlüssen. Die Crew überquert das Kabel rechtwinklig mit 80 % ihrer normalen Geschwindigkeit. Durch Drehen die Richtung wählen. Überträgt nur ganze Batterien. Das grüne Glas unter dem Gitter leuchtet, wenn eine verbundene Quelle mindestens eine ganze Batterie hat. Verbindet sich nicht mit Wärmerohren. Werte eines normalen Wärmerohrs: 1000 HP, Dichte 1, keine Panzerungskategorie, keine EMP-Absorption. Kosten: 4 Spulen + 2 Stahl."
    AmmoBeltName = "Crewless Munitionsband"
    AmmoBeltDesc = "Prototyp. Befördert Kugeln und EMP-Raketenteile Feld für Feld ohne Crew: Eingang hinten, Ausgang am Pfeil. Entnimmt aus dem Ausgang einer Munitions- oder EMP-Fabrik dahinter und beliefert das nächste Band, eine Kanone (Kugeln) oder einen Raketenwerfer im EMP-Modus (EMP-Teile). Ein Schuss pro Munitionsart und Feld. Werte eines Wärmerohrs: 1000 HP, 4 Stahl + 2 Spulen."
    AmmoBeltCornerLeftName = "Crewless Munitionsband-Ecke (links)"
    AmmoBeltCornerLeftDesc = "Prototyp. Band mit Linkskurve: Eingang hinten, Ausgang links. Entnimmt aus einem Fabrikausgang dahinter. Werte eines Wärmerohrs: 1000 HP, 4 Stahl + 2 Spulen."
    AmmoBeltCornerRightName = "Crewless Munitionsband-Ecke (rechts)"
    AmmoBeltCornerRightDesc = "Prototyp. Band mit Rechtskurve: Eingang hinten, Ausgang rechts. Entnimmt aus einem Fabrikausgang dahinter. Werte eines Wärmerohrs: 1000 HP, 4 Stahl + 2 Spulen."
    AmmoBeltMergerName = "Crewless Munitionsband-Zusammenführung"
    AmmoBeltMergerDesc = "Prototyp. Vereint Bänder: nimmt von hinten, links und rechts an, Ausgang am Pfeil. Werte eines Wärmerohrs: 1000 HP, 4 Stahl + 2 Spulen."
    AmmoBeltSplitterName = "Crewless Munitionsband-Verteiler"
    AmmoBeltSplitterDesc = "Prototyp. Eingang hinten; verteilt abwechselnd auf vorne, links und rechts und überspringt volle oder gesperrte Ausgänge. Sechs Schalter legen fest, welche Munition wo hinaus darf. Werte eines Wärmerohrs: 1000 HP, 4 Stahl + 2 Spulen."
    FilterBulletFront = "Verteiler: Kugeln zum vorderen Ausgang. Hell = erlaubt, dunkel = gesperrt. Klicken zum Umschalten; wird gespeichert."
    FilterBulletLeft = "Verteiler: Kugeln zum linken Ausgang. Hell = erlaubt, dunkel = gesperrt. Klicken zum Umschalten; wird gespeichert."
    FilterBulletRight = "Verteiler: Kugeln zum rechten Ausgang. Hell = erlaubt, dunkel = gesperrt. Klicken zum Umschalten; wird gespeichert."
    FilterEmpFront = "Verteiler: EMP-Raketenteile zum vorderen Ausgang. Hell = erlaubt, dunkel = gesperrt. Klicken zum Umschalten; wird gespeichert."
    FilterEmpLeft = "Verteiler: EMP-Raketenteile zum linken Ausgang. Hell = erlaubt, dunkel = gesperrt. Klicken zum Umschalten; wird gespeichert."
    FilterEmpRight = "Verteiler: EMP-Raketenteile zum rechten Ausgang. Hell = erlaubt, dunkel = gesperrt. Klicken zum Umschalten; wird gespeichert."
}
