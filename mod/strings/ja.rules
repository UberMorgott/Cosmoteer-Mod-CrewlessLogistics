CrewlessLogistics
{
    HeatCrossingName = "Crewless Logistics 熱・電気交差"
    HeatCrossingDesc = "オレンジの熱パイプと青い電力ケーブルが交差する部品。一方の軸で熱、もう一方で動力を独立して伝えます。回転させると両者の向きが入れ替わります。「動力」と「熱管理」で建造できます。乗組員は通行できません。暗色のカバーは見た目だけで、性能は通常の熱パイプと同じです。耐久力1000 HP、密度1。装甲カテゴリーには属さず、EMPを吸収しません。コスト：コイル4、鋼鉄2。"
    NetworkOff = "電力網：オフ。クリックするとこの装置をケーブルに接続します。初期状態はオフで、設定は保存されます。蓄えた動力は失われず、通常の動作や乗組員による運搬も引き続き利用できます。"
    NetworkOn = "電力網：オン。クリックするとこの装置をケーブルから切り離します。設定は保存されます。機関室から動力を受け取るスラスターも含め、各装置でこのスイッチをオンにする必要があります。オーバークロックは別に切り替えます。"
    CableName = "Crewless Logistics 電力ケーブル"
    CableDesc = "暗色の金属カバーで覆われた電力ケーブル。屋根は通常の船体と同じ外観です。4方向に自動接続し、バッテリー1個単位で動力を伝えます。接続された供給源にバッテリー1個分以上の動力があると、グリル下の緑のガラスが光ります。熱パイプには接続しません。乗組員は通行できません。カバーは見た目だけで、性能は通常の熱パイプと同じです。耐久力1000 HP、密度1。装甲カテゴリーには属さず、EMPを吸収しません。コスト：コイル4、鋼鉄2。"
    CrossingName = "Crewless Logistics 乗組員通路ケーブル"
    CrossingDesc = "向かい合う2つの電気ポートを備えた、乗組員が横断できるケーブル。乗組員はケーブルと直角の方向へ通常の80%の速度で通行できます。回転させて向きを選びます。動力はバッテリー1個単位で伝えます。接続された供給源にバッテリー1個分以上の動力があると、グリル下の緑のガラスが光ります。熱パイプには接続しません。性能は通常の熱パイプと同じです。耐久力1000 HP、密度1。装甲カテゴリーには属さず、EMPを吸収しません。コスト：コイル4、鋼鉄2。"
    AmmoBeltName = "Crewless 弾薬ベルト"
    AmmoBeltDesc = "試作品。乗組員なしで弾丸とEMPミサイル部品を1マスずつ運びます。入口は後ろ、出口は矢印の方向です。後ろにある弾薬工場またはEMP工場の出力から取り出し、次のベルト、キャノン（弾丸）、EMPモードのミサイルランチャー（EMP部品）へ送ります。1マスにつき弾薬の種類ごとに1発。熱パイプと同じ性能：耐久力1000、鋼鉄4、コイル2。"
    AmmoBeltCornerLeftName = "Crewless 弾薬ベルト・コーナー（左）"
    AmmoBeltCornerLeftDesc = "試作品。左に曲がるベルトです。入口は後ろ、出口は左側。後ろの工場の出力から取り出します。熱パイプと同じ性能：耐久力1000、鋼鉄4、コイル2。"
    AmmoBeltCornerRightName = "Crewless 弾薬ベルト・コーナー（右）"
    AmmoBeltCornerRightDesc = "試作品。右に曲がるベルトです。入口は後ろ、出口は右側。後ろの工場の出力から取り出します。熱パイプと同じ性能：耐久力1000、鋼鉄4、コイル2。"
    AmmoBeltMergerName = "Crewless 弾薬ベルト・合流"
    AmmoBeltMergerDesc = "試作品。ベルトを合流させます。後ろ・左・右から受け取り、矢印の方向へ出します。熱パイプと同じ性能：耐久力1000、鋼鉄4、コイル2。"
    AmmoBeltSplitterName = "Crewless 弾薬ベルト・分岐"
    AmmoBeltSplitterDesc = "試作品。入口は後ろ。前・左・右の出口へ順番に振り分け、満杯または禁止の出口は飛ばします。6つのスイッチで、どの弾薬をどの方向へ出すかを選べます。熱パイプと同じ性能：耐久力1000、鋼鉄4、コイル2。"
    FilterBulletFront = "分岐：弾丸を前の出口へ。明るい＝許可、暗い＝禁止。クリックで切り替え、設定は保存されます。"
    FilterBulletLeft = "分岐：弾丸を左の出口へ。明るい＝許可、暗い＝禁止。クリックで切り替え、設定は保存されます。"
    FilterBulletRight = "分岐：弾丸を右の出口へ。明るい＝許可、暗い＝禁止。クリックで切り替え、設定は保存されます。"
    FilterEmpFront = "分岐：EMPミサイル部品を前の出口へ。明るい＝許可、暗い＝禁止。クリックで切り替え、設定は保存されます。"
    FilterEmpLeft = "分岐：EMPミサイル部品を左の出口へ。明るい＝許可、暗い＝禁止。クリックで切り替え、設定は保存されます。"
    FilterEmpRight = "分岐：EMPミサイル部品を右の出口へ。明るい＝許可、暗い＝禁止。クリックで切り替え、設定は保存されます。"
}
