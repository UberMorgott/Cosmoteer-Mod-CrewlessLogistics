CrewlessLogistics
{
    HeatCrossingName = "Crewless Logistics 熱・電気交差"
    HeatCrossingDesc = "オレンジの熱パイプと青い電力ケーブルが交差する部品。一方の軸で熱、もう一方で動力を独立して伝えます。回転させると両者の向きが入れ替わります。「動力」と「熱管理」で建造できます。乗組員は通行できません。暗色のカバーは見た目だけで、性能は通常の熱パイプと同じです。耐久力1000 HP、密度1。装甲カテゴリーには属さず、EMPを吸収しません。コスト：コイル4、鋼鉄2。"
    NetworkOff = "電力網：オフ。クリックするとこの装置をケーブルに接続します。初期状態はオフで、設定は保存されます。蓄えた動力は失われず、通常の動作や乗組員による運搬も引き続き利用できます。"
    NetworkOn = "電力網：オン。クリックするとこの装置をケーブルから切り離します。設定は保存されます。機関室から動力を受け取るスラスターも含め、各装置でこのスイッチをオンにする必要があります。オーバークロックは別に切り替えます。"
    CableName = "Crewless Logistics 電力ケーブル"
    CableDesc = "暗色の金属カバーで覆われた電力ケーブル。屋根は通常の船体と同じ外観です。4方向に自動接続し、バッテリー1個単位で動力を伝えます。接続された供給源にバッテリー1個分以上の動力があると、グリル下の緑のガラスが光ります。熱パイプには接続しません。乗組員は通行できません。カバーは見た目だけで、性能は通常の熱パイプと同じです。耐久力1000 HP、密度1。装甲カテゴリーには属さず、EMPを吸収しません。コスト：コイル4、鋼鉄2。"
    CrossingName = "Crewless Logistics 乗組員通路ケーブル"
    CrossingDesc = "向かい合う2つの電気ポートを備えた、乗組員が横断できるケーブル。乗組員はケーブルと直角の方向へ通常の80%の速度で通行できます。回転させて向きを選びます。動力はバッテリー1個単位で伝えます。接続された供給源にバッテリー1個分以上の動力があると、グリル下の緑のガラスが光ります。熱パイプには接続しません。性能は通常の熱パイプと同じです。耐久力1000 HP、密度1。装甲カテゴリーには属さず、EMPを吸収しません。コスト：コイル4、鋼鉄2。"
}
