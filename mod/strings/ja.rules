CrewlessLogistics
{
    HeatCrossingName = "Crewless Logistics 熱・電気交差"
    HeatCrossingDesc = "オレンジの熱パイプと青い電力ケーブルが交差する部品。一方の軸で熱、もう一方で動力を独立して伝えます。回転させると両者の向きが入れ替わります。「動力」と「熱管理」で建造できます。乗組員は通行できません。暗色のカバーは見た目だけで、性能は通常の熱パイプと同じです。耐久力1000 HP、密度1。装甲カテゴリーには属さず、EMPを吸収しません。コスト：コイル4、鋼鉄2。"
    NetworkOff = "電力網：オフ。クリックするとこの装置をケーブルに接続します。初期状態はオフで、設定は保存されます。蓄えた動力は失われず、通常の動作や乗組員による運搬も引き続き利用できます。"
    NetworkOn = "電力網：オン。クリックするとこの装置をケーブルから切り離します。設定は保存されます。機関室から動力を受け取るスラスターも含め、各装置でこのスイッチをオンにする必要があります。オーバークロックは別に切り替えます。"
    CableName = "Crewless Logistics 電力ケーブル"
    CableDesc = "暗色の金属カバーで覆われた電力ケーブル。屋根は通常の船体と同じ外観です。4方向に自動接続し、バッテリー1個単位で動力を伝えます。接続された供給源にバッテリー1個分以上の動力があると、グリル下の緑のガラスが光ります。熱パイプには接続しません。乗組員は通行できません。カバーは見た目だけで、性能は通常の熱パイプと同じです。耐久力1000 HP、密度1。装甲カテゴリーには属さず、EMPを吸収しません。コスト：コイル4、鋼鉄2。"
    CrossingName = "Crewless Logistics 乗組員通路ケーブル"
    CrossingDesc = "向かい合う2つの電気ポートを備えた、乗組員が横断できるケーブル。乗組員はケーブルと直角の方向へ通常の80%の速度で通行できます。回転させて向きを選びます。動力はバッテリー1個単位で伝えます。接続された供給源にバッテリー1個分以上の動力があると、グリル下の緑のガラスが光ります。熱パイプには接続しません。性能は通常の熱パイプと同じです。耐久力1000 HP、密度1。装甲カテゴリーには属さず、EMPを吸収しません。コスト：コイル4、鋼鉄2。"
    BeltName = "Crewless Logistics ベルトコンベア"
    BeltDesc = "積み重ね可能な資源を2車線で毎秒2マス運びます。1マスの各車線に最大4個。片側だけから送られると自動で曲がり、直線の側面から合流するベルトは近い側の車線に載せます。乗組員は上を歩けます。回転で向きを決めます。Yet Another Mod Loader のライブラリが必要で、無い場合はただの床になります。費用は鋼鉄4 + コイル2。"
    SplitterName = "Crewless Logistics ベルト分配器"
    SplitterDesc = "1x2。後ろに入口2つ、前に出口2つ。車線ごとに出口へ交互に振り分けます。片方の出口が詰まっているか無い場合はもう一方へ送るので、2本のベルトの合流にも使えます。車線は保たれます。設定：入力優先、出力優先（進行方向の左/右）、資源フィルター。フィルターに合う物は出力優先側（優先なしなら左）へ、それ以外は反対側へ送ります。費用は鋼鉄8 + コイル4。"
    ConnectorName = "Crewless Logistics ベルトコネクター"
    ConnectorDesc = "選んだ資源を矢印の後ろと左右のマスから前のマスへ移します（複数の部屋は順番に使います）。部屋からベルト、ベルトから部屋、部屋から部屋、ベルトからベルトに対応。貨物室、工場、武器で使えますが、電力網には使いません。フィルターボタンで資源を選びます。初期値の「自動」は両隣が使える資源が1種類だけならそれを移し、それ以外は何も移しません。「なし」で停止します。供給元の優先（後ろ/左/右）はその側から先に取り、その側に何もないときだけ他から取ります。初期値は順番に取ります。電力は不要です。費用は鋼鉄4 + コイル2。"
    BeltHeatCrossingName = "Crewless Logistics ベルト・熱パイプ交差"
    BeltHeatCrossingDesc = "直線のベルトコンベアが熱パイプの上を通ります。一方の軸で資源、もう一方の軸で熱を運びます。回転でベルトの向きを決めます。曲がることはなく、側面から合流するベルトは近い側の車線に載せます。乗組員はベルトに沿って80%の速度で歩けます。性能は通常の熱パイプ交差と同じで、耐久力1000 HP、密度1。ベルトには Yet Another Mod Loader のライブラリが必要です。費用は鋼鉄4 + コイル2。"
    BeltCableCrossingName = "Crewless Logistics ベルト・ケーブル交差"
    BeltCableCrossingDesc = "直線のベルトコンベアが電力ケーブルの上を通ります。一方の軸で資源、もう一方の軸で完全なバッテリーを運びます。熱パイプには接続しません。回転でベルトの向きを決めます。曲がることはなく、側面から合流するベルトは近い側の車線に載せます。乗組員はベルトに沿って80%の速度で歩けます。性能は通常の熱パイプ交差と同じで、耐久力1000 HP、密度1。ベルトには Yet Another Mod Loader のライブラリが必要です。費用は鋼鉄4 + コイル2。"
    FilterAuto = "ベルトフィルター：自動。隣接する施設が受け取れる資源が1種類だけならそれを通し、それ以外は何も通しません。資源、「すべて」、「なし」から選べます。"
    FilterNone = "ベルトフィルター：なし。停止中、何も通しません。"
    FilterAny = "ベルトフィルター：すべての資源。"
    SplitterFilterNone = "スプリッターフィルター：なし。資源で振り分けません。"
    InputPriorityNone = "入力優先：なし。両方の入力を使います。"
    InputPriorityLeft = "入力優先：左。左の入力を先に使い、左に何もないときだけ右を使います。"
    InputPriorityRight = "入力優先：右。右の入力を先に使い、右に何もないときだけ左を使います。"
    OutputPriorityNone = "出力優先：なし。両方の出力へ交互に送ります。"
    OutputPriorityLeft = "出力優先：左。すべて左へ送り、左が受け取れない分だけ右へ送ります。"
    OutputPriorityRight = "出力優先：右。すべて右へ送り、右が受け取れない分だけ左へ送ります。"
    SourcePriorityRoundRobin = "供給元の優先：順番。後ろと左右の供給元を順番に使います。"
    SourcePriorityBack = "供給元の優先：後ろ。後ろから先に取り、後ろに何もないときだけ左右から取ります。"
    SourcePriorityLeft = "供給元の優先：左。左から先に取り、左に何もないときだけ他から取ります。"
    SourcePriorityRight = "供給元の優先：右。右から先に取り、右に何もないときだけ他から取ります。"
