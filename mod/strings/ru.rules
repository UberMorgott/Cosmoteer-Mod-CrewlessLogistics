CrewlessLogistics
{
    HeatCrossingName = "Пересечение тепла и электричества Crewless Logistics"
    HeatCrossingDesc = "Оранжевый теплопередатчик пересекает синий электрический кабель. Тепло идёт по одной оси, электричество — по другой. Поверните деталь, чтобы поменять направления местами. Экипаж не проходит. Есть в разделах «Энергия» и «Управление теплом». Тёмные панели — только внешний вид. Характеристики обычного теплопередатчика: прочность 1000, плотность 1, без категории брони и поглощения ЭМИ. Стоимость: 4 спирали + 2 стали."
    NetworkOff = "Электросеть: ВЫКЛ. Нажмите, чтобы подключить устройство к сети. По умолчанию выключена; положение переключателя сохраняется. Запас энергии, обычная работа устройства и доставка батарей экипажем не меняются."
    NetworkOn = "Электросеть: ВКЛ. Нажмите, чтобы отключить устройство от сети. Положение переключателя сохраняется. Включите его на каждом реакторе, накопителе и устройстве, которое должно быть в сети. Разгон включается отдельно."
    CableName = "Электрический кабель Crewless Logistics"
    CableDesc = "Четыре автоматических электрических подключения. Передаёт только целые батареи. Экипаж не проходит; с теплопередатчиками не соединяется. Зелёное стекло под решёткой светится, когда в подключённом источнике есть целая батарея. Снаружи обычная обшивка. Тёмные панели — только внешний вид. Характеристики обычного теплопередатчика: прочность 1000, плотность 1, без категории брони и поглощения ЭМИ. Стоимость: 4 спирали + 2 стали."
    CrossingName = "Проходной кабель Crewless Logistics"
    CrossingDesc = "Два электрических подключения с противоположных сторон. Экипаж проходит поперёк кабеля со скоростью 80%. Поверните деталь, чтобы выбрать направление кабеля. Передаёт только целые батареи; с теплопередатчиками не соединяется. Зелёное стекло под решёткой светится, когда в подключённом источнике есть целая батарея. Характеристики обычного теплопередатчика: прочность 1000, плотность 1, без категории брони и поглощения ЭМИ. Стоимость: 4 спирали + 2 стали."
    AmmoBeltName = "Лента боеприпасов Crewless"
    AmmoBeltDesc = "Прототип. Перемещает пули и детали ЭМИ-ракет от клетки к клетке без экипажа: вход сзади, выход по стрелке. Забирает из выхода завода боеприпасов или завода ЭМИ-ракет позади и подаёт в следующую ленту, пушку (пули) или пусковую установку в режиме ЭМИ (детали ЭМИ-ракет). По одному заряду каждого типа на клетку. Характеристики теплопередатчика: прочность 1000, 4 стали + 2 спирали."
    AmmoBeltCornerLeftName = "Угол ленты боеприпасов Crewless (влево)"
    AmmoBeltCornerLeftDesc = "Прототип. Лента с поворотом налево: вход сзади, выход слева. Забирает из выхода завода позади. Характеристики теплопередатчика: прочность 1000, 4 стали + 2 спирали."
    AmmoBeltCornerRightName = "Угол ленты боеприпасов Crewless (вправо)"
    AmmoBeltCornerRightDesc = "Прототип. Лента с поворотом направо: вход сзади, выход справа. Забирает из выхода завода позади. Характеристики теплопередатчика: прочность 1000, 4 стали + 2 спирали."
    AmmoBeltMergerName = "Слияние лент боеприпасов Crewless"
    AmmoBeltMergerDesc = "Прототип. Соединяет ленты: принимает заряды сзади, слева и справа, выход по стрелке. Характеристики теплопередатчика: прочность 1000, 4 стали + 2 спирали."
    AmmoBeltSplitterName = "Разветвитель лент боеприпасов Crewless"
    AmmoBeltSplitterDesc = "Прототип. Вход сзади; по очереди раздаёт заряды на выходы спереди, слева и справа, пропуская заполненные и запрещённые. Шесть переключателей задают, какой тип боеприпасов куда может выходить. Характеристики теплопередатчика: прочность 1000, 4 стали + 2 спирали."
    FilterBulletFront = "Разветвитель: пули на выход спереди. Ярко — разрешено, темно — запрещено. Нажмите, чтобы переключить; сохраняется."
    FilterBulletLeft = "Разветвитель: пули на выход слева. Ярко — разрешено, темно — запрещено. Нажмите, чтобы переключить; сохраняется."
    FilterBulletRight = "Разветвитель: пули на выход справа. Ярко — разрешено, темно — запрещено. Нажмите, чтобы переключить; сохраняется."
    FilterEmpFront = "Разветвитель: детали ЭМИ-ракет на выход спереди. Ярко — разрешено, темно — запрещено. Нажмите, чтобы переключить; сохраняется."
    FilterEmpLeft = "Разветвитель: детали ЭМИ-ракет на выход слева. Ярко — разрешено, темно — запрещено. Нажмите, чтобы переключить; сохраняется."
    FilterEmpRight = "Разветвитель: детали ЭМИ-ракет на выход справа. Ярко — разрешено, темно — запрещено. Нажмите, чтобы переключить; сохраняется."
