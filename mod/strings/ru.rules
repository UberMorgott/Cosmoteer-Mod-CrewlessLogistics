CrewlessLogistics
{
    HeatCrossingName = "Пересечение тепла и электричества Crewless Logistics"
    HeatCrossingDesc = "Оранжевый теплопередатчик пересекает синий электрический кабель. Тепло идёт по одной оси, электричество — по другой. Поверните деталь, чтобы поменять направления местами. Экипаж не проходит. Есть в разделах «Энергия» и «Управление теплом». Тёмные панели — только внешний вид. Характеристики обычного теплопередатчика: прочность 1000, плотность 1, без категории брони и поглощения ЭМИ. Стоимость: 4 спирали + 2 стали."
    NetworkOff = "Электросеть: ВЫКЛ. Нажмите, чтобы подключить устройство к сети. По умолчанию выключена; положение переключателя сохраняется. Запас энергии, обычная работа устройства и доставка батарей экипажем не меняются."
    NetworkOn = "Электросеть: ВКЛ. Нажмите, чтобы отключить устройство от сети. Положение переключателя сохраняется. Включите его на каждом реакторе, накопителе и устройстве, которое должно быть в сети. Разгон включается отдельно."
    CableName = "Электрический кабель Crewless Logistics"
    CableDesc = "Четыре автоматических электрических подключения. Передаёт только целые батареи. Экипаж не проходит; с теплопередатчиками не соединяется. Зелёное стекло под решёткой светится, когда в подключённом источнике есть целая батарея. Снаружи обычная обшивка. Тёмные панели — только внешний вид. Характеристики обычного теплопередатчика: прочность 1000, плотность 1, без категории брони и поглощения ЭМИ. Стоимость: 4 спирали + 2 стали."
    CrossingName = "Проходной кабель Crewless Logistics"
    CrossingDesc = "Два электрических подключения с противоположных сторон. Экипаж проходит поперёк кабеля со скоростью 80%. Поверните деталь, чтобы выбрать направление кабеля. Передаёт только целые батареи; с теплопередатчиками не соединяется. Зелёное стекло под решёткой светится, когда в подключённом источнике есть целая батарея. Характеристики обычного теплопередатчика: прочность 1000, плотность 1, без категории брони и поглощения ЭМИ. Стоимость: 4 спирали + 2 стали."
    BeltName = "Crewless Logistics: конвейер"
    BeltDesc = "Перевозит любой складируемый ресурс по двум полосам со скоростью 2 клетки в секунду, до 4 предметов на полосу в клетке. Сам поворачивает, если подача идёт только с одного бока; конвейер, подающий сбоку на прямой участок, кладёт предметы на ближнюю полосу. Экипаж может ходить по нему. Поворот задаёт направление. Нужна библиотека Yet Another Mod Loader, без неё это обычный пол. Стоит 4 стали + 2 спирали."
    SplitterName = "Crewless Logistics: разделитель конвейера"
    SplitterDesc = "1x2. Два входа сзади, два выхода спереди. Предметы на каждой полосе чередуются между выходами; если один выход занят или отсутствует, всё идёт в другой, поэтому он же сливает два конвейера. Полосы сохраняются. Настройки: приоритет входа, приоритет выхода (слева/справа по ходу) и фильтр ресурса: его предметы идут на сторону приоритета выхода (без приоритета — влево), все остальные на другую сторону. Стоит 8 стали + 4 спирали."
    ConnectorName = "Crewless Logistics: соединитель конвейера"
    ConnectorDesc = "Переносит выбранный ресурс из клеток за стрелкой и по бокам от неё (несколько отсеков работают по очереди) в клетку перед ней: из отсека на конвейер, с конвейера в отсек, из отсека в отсек или с конвейера на конвейер. Работает с трюмами, заводами и орудиями, но не с электросетью. Ресурс выбирается кнопкой фильтра; по умолчанию «Авто» переносит единственный ресурс, подходящий обоим соседям, иначе ничего; «Нет» останавливает его. Приоритет источника (сзади/слева/справа) берёт сначала с этой стороны, с остальных только когда там пусто; по умолчанию по очереди. Энергия не нужна. Стоит 4 стали + 2 спирали."
    BeltCrossingName = "Crewless Logistics: переезд конвейера"
    BeltCrossingDesc = "Прямой конвейер проходит над теплопередатчиком или электрокабелем и подстраивается под то, что его пересекает: предметы движутся по одной оси, тепло или целые батареи — по другой (трубы соединяются только с трубами, кабели — только с кабелями). Поворот задаёт направление ленты. Не поворачивает; конвейер, подающий сбоку, кладёт предметы на ближнюю полосу. Экипаж может ходить вдоль ленты со скоростью 70%. Характеристики обычного пересечения теплопередатчика: прочность 1000, плотность 1. Для ленты нужна библиотека Yet Another Mod Loader. Стоит 4 стали + 2 спирали."
    FilterAuto = "Фильтр конвейера: авто. Пропускает единственный ресурс, который принимают соседи; иначе ничего. Выберите ресурс, «Любой» или «Нет»."
    FilterNone = "Фильтр конвейера: нет. Остановлен, ничего не проходит."
    FilterAny = "Фильтр конвейера: любой ресурс."
    SplitterFilterNone = "Фильтр разделителя: нет. Предметы не сортируются по ресурсу."
    InputPriorityNone = "Приоритет входа: нет. Используются оба входа."
    InputPriorityLeft = "Приоритет входа: слева. Сначала левый вход; правый только когда слева ничего нет."
    InputPriorityRight = "Приоритет входа: справа. Сначала правый вход; левый только когда справа ничего нет."
    OutputPriorityNone = "Приоритет выхода: нет. Предметы чередуются между выходами."
    OutputPriorityLeft = "Приоритет выхода: слева. Всё идёт влево; вправо только то, что не помещается слева."
    OutputPriorityRight = "Приоритет выхода: справа. Всё идёт вправо; влево только то, что не помещается справа."
    SourcePriorityRoundRobin = "Приоритет источника: по очереди. Источники сзади и по бокам работают по очереди."
    SourcePriorityBack = "Приоритет источника: сзади. Сначала сзади; с боков только когда сзади пусто."
    SourcePriorityLeft = "Приоритет источника: слева. Сначала слева; с остальных только когда слева пусто."
    SourcePriorityRight = "Приоритет источника: справа. Сначала справа; с остальных только когда справа пусто."
}
