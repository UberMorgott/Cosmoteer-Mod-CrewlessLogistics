CrewlessLogistics
{
    HeatCrossingName = "Cruce de calor/electricidad de Crewless Logistics"
    HeatCrossingDesc = "Un tubo de calor naranja por un eje y un cable eléctrico azul por el otro. Gira la pieza para intercambiar los ejes. Bloquea el paso de la tripulación. Disponible en Potencia y en Administración de calor. Las placas oscuras son solo decorativas. Tiene las características de un tubo de calor del juego base: 1000 puntos de vida, densidad 1, sin categoría de blindaje ni absorción de EMP. Coste: 4 bobinas y 2 unidades de acero."
    NetworkOff = "Red eléctrica: APAGADA. Haz clic para conectar este dispositivo a los cables. Apagada por defecto; su estado se guarda. La energía almacenada se conserva. El funcionamiento normal y el transporte por la tripulación no cambian."
    NetworkOn = "Red eléctrica: ENCENDIDA. Haz clic para desconectar este dispositivo de los cables. Su estado se guarda. Enciende el interruptor en cada dispositivo que quieras conectar. La sobreaceleración se controla por separado."
    CableName = "Cable eléctrico de Crewless Logistics"
    CableDesc = "Cuatro conexiones eléctricas automáticas; solo transfiere baterías enteras. No se conecta a tubos de calor. Bloquea el paso de la tripulación. La luz verde se enciende cuando una fuente conectada tiene una batería entera. Por fuera lo cubre un techo de casco liso. Las placas oscuras son solo decorativas. Tiene las características de un tubo de calor del juego base: 1000 puntos de vida, densidad 1, sin categoría de blindaje ni absorción de EMP. Coste: 4 bobinas y 2 unidades de acero."
    CrossingName = "Paso de tripulación de Crewless Logistics"
    CrossingDesc = "Dos conexiones eléctricas opuestas; permite el paso de la tripulación. La tripulación pasa en perpendicular al cable al 80 % de su velocidad. Gira la pieza para elegir la dirección. La luz verde indica que una fuente conectada tiene una batería entera. Solo transfiere baterías enteras; no se conecta a tubos de calor. Las placas oscuras son solo decorativas. Tiene las características de un tubo de calor del juego base: 1000 puntos de vida, densidad 1, sin categoría de blindaje ni absorción de EMP. Coste: 4 bobinas y 2 unidades de acero."
    AmmoBeltName = "Cinta de munición Crewless"
    AmmoBeltDesc = "Prototipo. Mueve balas y piezas de misil EMP casilla a casilla sin tripulación: entrada por detrás, salida por la flecha. Toma de la salida de una fábrica de munición o de EMP situada detrás y abastece a la siguiente cinta, a un cañón (balas) o a un lanzamisiles en modo EMP (piezas EMP). Una carga por tipo de munición y casilla. Estadísticas de tubo de calor: 1000 PV, 4 acero + 2 bobinas."
    AmmoBeltCornerLeftName = "Esquina de cinta de munición Crewless (izquierda)"
    AmmoBeltCornerLeftDesc = "Prototipo. Cinta que gira a la izquierda: entrada por detrás, salida por la izquierda. Toma de la salida de una fábrica situada detrás. Estadísticas de tubo de calor: 1000 PV, 4 acero + 2 bobinas."
    AmmoBeltCornerRightName = "Esquina de cinta de munición Crewless (derecha)"
    AmmoBeltCornerRightDesc = "Prototipo. Cinta que gira a la derecha: entrada por detrás, salida por la derecha. Toma de la salida de una fábrica situada detrás. Estadísticas de tubo de calor: 1000 PV, 4 acero + 2 bobinas."
    AmmoBeltMergerName = "Unión de cintas de munición Crewless"
    AmmoBeltMergerDesc = "Prototipo. Une cintas: recibe por detrás, izquierda y derecha; salida por la flecha. Estadísticas de tubo de calor: 1000 PV, 4 acero + 2 bobinas."
    AmmoBeltSplitterName = "Divisor de cintas de munición Crewless"
    AmmoBeltSplitterDesc = "Prototipo. Entrada por detrás; reparte por turnos entre las salidas delantera, izquierda y derecha, saltando las llenas o bloqueadas. Seis interruptores eligen qué munición sale por cada lado. Estadísticas de tubo de calor: 1000 PV, 4 acero + 2 bobinas."
    FilterBulletFront = "Divisor: balas a la salida delantera. Claro = permitido, oscuro = bloqueado. Clic para cambiar; se guarda."
    FilterBulletLeft = "Divisor: balas a la salida izquierda. Claro = permitido, oscuro = bloqueado. Clic para cambiar; se guarda."
    FilterBulletRight = "Divisor: balas a la salida derecha. Claro = permitido, oscuro = bloqueado. Clic para cambiar; se guarda."
    FilterEmpFront = "Divisor: piezas de misil EMP a la salida delantera. Claro = permitido, oscuro = bloqueado. Clic para cambiar; se guarda."
    FilterEmpLeft = "Divisor: piezas de misil EMP a la salida izquierda. Claro = permitido, oscuro = bloqueado. Clic para cambiar; se guarda."
    FilterEmpRight = "Divisor: piezas de misil EMP a la salida derecha. Claro = permitido, oscuro = bloqueado. Clic para cambiar; se guarda."
}
