CrewlessLogistics
{
    HeatCrossingName = "Cruce de calor/electricidad de Crewless Logistics"
    HeatCrossingDesc = "Un tubo de calor naranja por un eje y un cable eléctrico azul por el otro. Gira la pieza para intercambiar los ejes. Bloquea el paso de la tripulación. Disponible en Potencia y en Administración de calor. Las placas oscuras son solo decorativas. Tiene las características de un tubo de calor del juego base: 1000 puntos de vida, densidad 1, sin categoría de blindaje ni absorción de EMP. Coste: 4 bobinas y 2 unidades de acero."
    NetworkOff = "Red eléctrica: APAGADA. Haz clic para conectar este dispositivo a los cables. Apagada por defecto; su estado se guarda. La energía almacenada se conserva. El funcionamiento normal y el transporte por la tripulación no cambian."
    NetworkOn = "Red eléctrica: ENCENDIDA. Haz clic para desconectar este dispositivo de los cables. Su estado se guarda. Enciende el interruptor en cada dispositivo que quieras conectar. La sobreaceleración se controla por separado."
    CableName = "Cable eléctrico de Crewless Logistics"
    CableDesc = "Cuatro conexiones eléctricas automáticas; solo transfiere baterías enteras. No se conecta a tubos de calor. Bloquea el paso de la tripulación. La luz verde se enciende cuando una fuente conectada tiene una batería entera. Por fuera lo cubre un techo de casco liso. Las placas oscuras son solo decorativas. Tiene las características de un tubo de calor del juego base: 1000 puntos de vida, densidad 1, sin categoría de blindaje ni absorción de EMP. Coste: 4 bobinas y 2 unidades de acero."
    CrossingName = "Paso de tripulación de Crewless Logistics"
    CrossingDesc = "Dos conexiones eléctricas opuestas; permite el paso de la tripulación. La tripulación pasa en perpendicular al cable al 80 % de su velocidad. Gira la pieza para elegir la dirección. La luz verde indica que una fuente conectada tiene una batería entera. Solo transfiere baterías enteras; no se conecta a tubos de calor. Las placas oscuras son solo decorativas. Tiene las características de un tubo de calor del juego base: 1000 puntos de vida, densidad 1, sin categoría de blindaje ni absorción de EMP. Coste: 4 bobinas y 2 unidades de acero."
    BeltName = "Crewless Logistics: cinta transportadora"
    BeltDesc = "Transporta cualquier recurso apilable por dos carriles a 2 casillas/s, hasta 4 objetos por carril y casilla. Gira sola cuando solo recibe por un lado; una cinta que entra por el lado de un tramo recto deja sus objetos en el carril cercano. La tripulación puede caminar sobre ella. Gírala para fijar la dirección. Requiere la biblioteca Yet Another Mod Loader; sin ella la cinta es suelo normal. Cuesta 4 de acero + 2 bobinas."
    SplitterName = "Crewless Logistics: divisor de cinta"
    SplitterDesc = "1x2. Dos entradas detrás y dos salidas delante. Los objetos se alternan entre las salidas carril por carril; si una salida está bloqueada o no existe, todo va a la otra, así que también une dos cintas. Conserva los carriles. Ajustes: prioridad de entrada, prioridad de salida (izquierda/derecha según el avance) y un filtro de recurso cuyos objetos van al lado de la prioridad de salida (izquierda si no hay), y el resto al otro lado. Cuesta 8 de acero + 4 bobinas."
    ConnectorName = "Crewless Logistics: conector de cinta"
    ConnectorDesc = "Mueve el recurso elegido de las casillas detrás y a los lados de la flecha (varias salas se turnan) a la de delante: sala a cinta, cinta a sala, sala a sala o cinta a cinta. Funciona con bodegas, fábricas y armas, nunca con la red eléctrica. Elige el recurso con el botón de filtro; el valor inicial Automático mueve el único recurso que ambos vecinos pueden usar y, si no, nada; Ninguno lo detiene. La prioridad de origen (detrás/izquierda/derecha) toma primero de ese lado y de los demás solo cuando no tiene nada; por defecto se turnan. No necesita energía. Cuesta 4 de acero + 2 bobinas."
    BeltCrossingName = "Crewless Logistics: cruce de cinta"
    BeltCrossingDesc = "Una cinta transportadora recta pasa sobre una tubería térmica o un cable eléctrico y se adapta a lo que la cruza: los objetos avanzan por un eje y el calor o las baterías completas por el otro (las tuberías solo se conectan con tuberías y los cables con cables). Gira la pieza para fijar la dirección de la cinta. Nunca gira; una cinta que alimenta su lateral deja los objetos en el carril cercano. La tripulación puede caminar a lo largo de la cinta al 70 % de velocidad. Estadísticas del cruce de tubería térmica normal: 1000 PV, densidad 1. La cinta necesita la biblioteca Yet Another Mod Loader. Cuesta 4 de acero + 2 bobinas."
    FilterAuto = "Filtro de cinta: Automático. Deja pasar el único recurso que aceptan los vecinos; si no, nada. Elige un recurso, Cualquiera o Ninguno."
    FilterNone = "Filtro de cinta: Ninguno. Detenido, no pasa nada."
    FilterAny = "Filtro de cinta: cualquier recurso."
    SplitterFilterNone = "Filtro del divisor: ninguno. Los objetos no se clasifican por recurso."
    InputPriorityNone = "Prioridad de entrada: ninguna. Se usan ambas entradas."
    InputPriorityLeft = "Prioridad de entrada: izquierda. Primero la entrada izquierda; la derecha solo cuando la izquierda no trae nada."
    InputPriorityRight = "Prioridad de entrada: derecha. Primero la entrada derecha; la izquierda solo cuando la derecha no trae nada."
    OutputPriorityNone = "Prioridad de salida: ninguna. Los objetos se alternan entre ambas salidas."
    OutputPriorityLeft = "Prioridad de salida: izquierda. Todo va a la izquierda; la derecha solo recibe lo que la izquierda no admite."
    OutputPriorityRight = "Prioridad de salida: derecha. Todo va a la derecha; la izquierda solo recibe lo que la derecha no admite."
    SourcePriorityRoundRobin = "Prioridad de origen: por turnos. Los orígenes de detrás y de los lados se turnan."
    SourcePriorityBack = "Prioridad de origen: detrás. Toma primero de detrás; de los lados solo cuando detrás no hay nada."
    SourcePriorityLeft = "Prioridad de origen: izquierda. Toma primero de la izquierda; de los demás solo cuando la izquierda no tiene nada."
    SourcePriorityRight = "Prioridad de origen: derecha. Toma primero de la derecha; de los demás solo cuando la derecha no tiene nada."
}
