CrewlessLogistics
{
    HeatCrossingName = "Cruzamento de calor/eletricidade Crewless Logistics"
    HeatCrossingDesc = "Um termoduto laranja em um eixo e um cabo elétrico azul no outro. Gire a peça para trocar os eixos. Bloqueia a passagem da tripulação. Disponível em Energia e em Gerenciamento de calor. As placas escuras são apenas decorativas. Tem as características de um termoduto do jogo base: 1000 pontos de vida, densidade 1, sem categoria de blindagem nem absorção de P.E.M. Custo: 4 bobinas e 2 unidades de aço."
    NetworkOff = "Rede elétrica: DESLIGADA. Clique para conectar este dispositivo aos cabos. Desligada por padrão; seu estado é salvo. A energia armazenada é mantida. O funcionamento normal e o transporte pela tripulação não mudam."
    NetworkOn = "Rede elétrica: LIGADA. Clique para desconectar este dispositivo dos cabos. Seu estado é salvo. Ligue o interruptor em cada dispositivo que quiser conectar. O overclock é controlado separadamente."
    CableName = "Cabo elétrico Crewless Logistics"
    CableDesc = "Quatro conexões elétricas automáticas; transfere apenas baterias inteiras. Não se conecta a termodutos. Bloqueia a passagem da tripulação. A luz verde acende quando uma fonte conectada tem uma bateria inteira. Por fora, tem um teto de casco comum. As placas escuras são apenas decorativas. Tem as características de um termoduto do jogo base: 1000 pontos de vida, densidade 1, sem categoria de blindagem nem absorção de P.E.M. Custo: 4 bobinas e 2 unidades de aço."
    CrossingName = "Passagem de tripulação Crewless Logistics"
    CrossingDesc = "Duas conexões elétricas opostas; permite a passagem da tripulação. A tripulação passa perpendicularmente ao cabo a 80% da velocidade. Gire a peça para escolher a direção. A luz verde indica que uma fonte conectada tem uma bateria inteira. Transfere apenas baterias inteiras; não se conecta a termodutos. As placas escuras são apenas decorativas. Tem as características de um termoduto do jogo base: 1000 pontos de vida, densidade 1, sem categoria de blindagem nem absorção de P.E.M. Custo: 4 bobinas e 2 unidades de aço."
    AmmoBeltName = "Esteira de munição Crewless"
    AmmoBeltDesc = "Protótipo. Move balas e peças de míssil EMP casa a casa sem tripulação: entrada atrás, saída na seta. Retira da saída de uma fábrica de munição ou de EMP atrás dela e abastece a próxima esteira, um canhão (balas) ou um lançador de mísseis no modo EMP (peças EMP). Uma carga por tipo de munição por casa. Atributos de tubo de calor: 1000 PV, 4 aço + 2 bobinas."
    AmmoBeltCornerLeftName = "Curva de esteira de munição Crewless (esquerda)"
    AmmoBeltCornerLeftDesc = "Protótipo. Esteira que vira à esquerda: entrada atrás, saída à esquerda. Retira da saída de uma fábrica atrás dela. Atributos de tubo de calor: 1000 PV, 4 aço + 2 bobinas."
    AmmoBeltCornerRightName = "Curva de esteira de munição Crewless (direita)"
    AmmoBeltCornerRightDesc = "Protótipo. Esteira que vira à direita: entrada atrás, saída à direita. Retira da saída de uma fábrica atrás dela. Atributos de tubo de calor: 1000 PV, 4 aço + 2 bobinas."
    AmmoBeltMergerName = "Junção de esteiras de munição Crewless"
    AmmoBeltMergerDesc = "Protótipo. Une esteiras: recebe por trás, pela esquerda e pela direita; saída na seta. Atributos de tubo de calor: 1000 PV, 4 aço + 2 bobinas."
    AmmoBeltSplitterName = "Divisor de esteiras de munição Crewless"
    AmmoBeltSplitterDesc = "Protótipo. Entrada atrás; reparte em turnos entre as saídas da frente, esquerda e direita, pulando as cheias ou bloqueadas. Seis interruptores escolhem qual munição sai por qual lado. Atributos de tubo de calor: 1000 PV, 4 aço + 2 bobinas."
    FilterBulletFront = "Divisor: balas para a saída da frente. Claro = permitido, escuro = bloqueado. Clique para alternar; é salvo."
    FilterBulletLeft = "Divisor: balas para a saída esquerda. Claro = permitido, escuro = bloqueado. Clique para alternar; é salvo."
    FilterBulletRight = "Divisor: balas para a saída direita. Claro = permitido, escuro = bloqueado. Clique para alternar; é salvo."
    FilterEmpFront = "Divisor: peças de míssil EMP para a saída da frente. Claro = permitido, escuro = bloqueado. Clique para alternar; é salvo."
    FilterEmpLeft = "Divisor: peças de míssil EMP para a saída esquerda. Claro = permitido, escuro = bloqueado. Clique para alternar; é salvo."
    FilterEmpRight = "Divisor: peças de míssil EMP para a saída direita. Claro = permitido, escuro = bloqueado. Clique para alternar; é salvo."
}
