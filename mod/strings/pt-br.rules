CrewlessLogistics
{
    HeatCrossingName = "Cruzamento de calor/eletricidade Crewless Logistics"
    HeatCrossingDesc = "Um termoduto laranja em um eixo e um cabo elétrico azul no outro. Gire a peça para trocar os eixos. Bloqueia a passagem da tripulação. Disponível em Energia e em Gerenciamento de calor. As placas escuras são apenas decorativas. Tem as características de um termoduto do jogo base: 1000 pontos de vida, densidade 1, sem categoria de blindagem nem absorção de P.E.M. Custo: 4 bobinas e 2 unidades de aço."
    NetworkOff = "Rede elétrica: DESLIGADA. Clique para conectar este dispositivo aos cabos. Desligada por padrão; seu estado é salvo. A energia armazenada é mantida. O funcionamento normal e o transporte pela tripulação não mudam."
    NetworkOn = "Rede elétrica: LIGADA. Clique para desconectar este dispositivo dos cabos. Seu estado é salvo. Ligue o interruptor em cada dispositivo que quiser conectar. O overclock é controlado separadamente."
    CableName = "Cabo elétrico Crewless Logistics"
    CableDesc = "Quatro conexões elétricas automáticas; transfere apenas baterias inteiras. Não se conecta a termodutos. Bloqueia a passagem da tripulação. A luz verde acende quando uma fonte conectada tem uma bateria inteira. Por fora, tem um teto de casco comum. As placas escuras são apenas decorativas. Tem as características de um termoduto do jogo base: 1000 pontos de vida, densidade 1, sem categoria de blindagem nem absorção de P.E.M. Custo: 4 bobinas e 2 unidades de aço."
    CrossingName = "Passagem de tripulação Crewless Logistics"
    CrossingDesc = "Duas conexões elétricas opostas; permite a passagem da tripulação. A tripulação passa perpendicularmente ao cabo a 80% da velocidade. Gire a peça para escolher a direção. A luz verde indica que uma fonte conectada tem uma bateria inteira. Transfere apenas baterias inteiras; não se conecta a termodutos. As placas escuras são apenas decorativas. Tem as características de um termoduto do jogo base: 1000 pontos de vida, densidade 1, sem categoria de blindagem nem absorção de P.E.M. Custo: 4 bobinas e 2 unidades de aço."
    BeltName = "Crewless Logistics: esteira transportadora"
    BeltDesc = "Leva qualquer recurso empilhável em duas faixas a 2 casas/s, até 4 itens por faixa em cada casa. Faz curva sozinha quando recebe por um lado só; uma esteira que entra pela lateral de um trecho reto coloca os itens na faixa próxima. A tripulação pode andar sobre ela. Gire para definir a direção. Precisa da biblioteca Yet Another Mod Loader; sem ela a esteira é só piso. Custa 4 de aço + 2 bobinas."
    SplitterName = "Crewless Logistics: divisor de esteira"
    SplitterDesc = "1x2. Duas entradas atrás e duas saídas na frente. Os itens se alternam entre as saídas faixa por faixa; se uma saída estiver bloqueada ou faltar, tudo vai para a outra, então ele também junta duas esteiras. As faixas são mantidas. Sem filtro. Custa 8 de aço + 4 bobinas."
    ConnectorName = "Crewless Logistics: conector de esteira"
    ConnectorDesc = "Move o recurso escolhido da casa atrás da seta para a casa da frente: sala para esteira, esteira para sala, sala para sala ou esteira para esteira. Funciona com porões de carga, fábricas e armas, nunca com a rede elétrica. Escolha o recurso no botão de filtro; o padrão Nenhum não move nada. Não precisa de energia. Custa 4 de aço + 2 bobinas."
    FilterNone = "Filtro da esteira: Nenhum. Nada passa. Escolha um recurso ou Qualquer."
    FilterAny = "Filtro da esteira: qualquer recurso."
}
