CrewlessLogistics
{
    HeatCrossingName = "Crewless Logistics 热能/电力交叉"
    HeatCrossingDesc = "橙色热管与蓝色电缆交叉的部件。沿一条轴传热、另一条轴输电，两者互不相连。旋转即可交换方向。可在“能源”和“热能管理”分类中建造。船员无法通过。深色外壳只影响外观，属性与原版热管相同：1000 HP、密度 1，不属于装甲类别，也不吸收 EMP。造价：4 线圈 + 2 钢板。"
    NetworkOff = "电网：关。点击将此设备接入电缆。默认关闭，设置会保存。已储存的能源会保留，设备照常运行，船员仍可运送电池。"
    NetworkOn = "电网：开。点击断开此设备与电缆的连接。设置会保存。每个设备都必须打开自身开关，包括从引擎室接收能源的推进器。超频模式需另行切换。"
    CableName = "Crewless Logistics 电力电缆"
    CableDesc = "带有深色金属外壳的电力电缆，外部屋顶为普通船体外观。四个方向自动连接，只传输整颗电池。相连的电源至少存有一颗电池时，格栅下的绿色玻璃会亮起。不与热管连接，船员无法通过。外壳只影响外观，属性与原版热管相同：1000 HP、密度 1，不属于装甲类别，也不吸收 EMP。造价：4 线圈 + 2 钢板。"
    CrossingName = "Crewless Logistics 船员通道电缆"
    CrossingDesc = "可供船员横穿的电缆，两端设有相对的电力接口。船员可沿垂直于电缆的方向，以正常速度的 80% 穿过。旋转部件可调整方向。只传输整颗电池。相连的电源至少存有一颗电池时，格栅下的绿色玻璃会亮起。不与热管连接。属性与原版热管相同：1000 HP、密度 1，不属于装甲类别，也不吸收 EMP。造价：4 线圈 + 2 钢板。"
}
