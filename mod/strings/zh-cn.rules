CrewlessLogistics
{
    HeatCrossingName = "Crewless Logistics 热能/电力交叉"
    HeatCrossingDesc = "橙色热管与蓝色电缆交叉的部件。沿一条轴传热、另一条轴输电，两者互不相连。旋转即可交换方向。可在“能源”和“热能管理”分类中建造。船员无法通过。深色外壳只影响外观，属性与原版热管相同：1000 HP、密度 1，不属于装甲类别，也不吸收 EMP。造价：4 线圈 + 2 钢板。"
    NetworkOff = "电网：关。点击将此设备接入电缆。默认关闭，设置会保存。已储存的能源会保留，设备照常运行，船员仍可运送电池。"
    NetworkOn = "电网：开。点击断开此设备与电缆的连接。设置会保存。每个设备都必须打开自身开关，包括从引擎室接收能源的推进器。超频模式需另行切换。"
    CableName = "Crewless Logistics 电力电缆"
    CableDesc = "带有深色金属外壳的电力电缆，外部屋顶为普通船体外观。四个方向自动连接，只传输整颗电池。相连的电源至少存有一颗电池时，格栅下的绿色玻璃会亮起。不与热管连接，船员无法通过。外壳只影响外观，属性与原版热管相同：1000 HP、密度 1，不属于装甲类别，也不吸收 EMP。造价：4 线圈 + 2 钢板。"
    CrossingName = "Crewless Logistics 船员通道电缆"
    CrossingDesc = "可供船员横穿的电缆，两端设有相对的电力接口。船员可沿垂直于电缆的方向，以正常速度的 80% 穿过。旋转部件可调整方向。只传输整颗电池。相连的电源至少存有一颗电池时，格栅下的绿色玻璃会亮起。不与热管连接。属性与原版热管相同：1000 HP、密度 1，不属于装甲类别，也不吸收 EMP。造价：4 线圈 + 2 钢板。"
    AmmoBeltName = "Crewless 弹药传送带"
    AmmoBeltDesc = "原型。无需船员，逐格运送子弹和EMP导弹部件：后方输入，箭头方向输出。从身后弹药工厂或EMP工厂的输出口取货，送往下一段传送带、加农炮（子弹）或EMP模式的导弹发射器（EMP部件）。每格每种弹药一发。属性与热管相同：耐久1000，4 钢板 + 2 线圈。"
    AmmoBeltCornerLeftName = "Crewless 弹药传送带转角（左）"
    AmmoBeltCornerLeftDesc = "原型。向左转的传送带：后方输入，左侧输出。从身后工厂的输出口取货。属性与热管相同：耐久1000，4 钢板 + 2 线圈。"
    AmmoBeltCornerRightName = "Crewless 弹药传送带转角（右）"
    AmmoBeltCornerRightDesc = "原型。向右转的传送带：后方输入，右侧输出。从身后工厂的输出口取货。属性与热管相同：耐久1000，4 钢板 + 2 线圈。"
    AmmoBeltMergerName = "Crewless 弹药传送带汇合器"
    AmmoBeltMergerDesc = "原型。合并传送带：从后方、左侧和右侧接收，向箭头方向输出。属性与热管相同：耐久1000，4 钢板 + 2 线圈。"
    AmmoBeltSplitterName = "Crewless 弹药传送带分流器"
    AmmoBeltSplitterDesc = "原型。后方输入；轮流分配到前、左、右输出口，跳过已满或禁止的出口。六个开关决定哪种弹药从哪一侧输出。属性与热管相同：耐久1000，4 钢板 + 2 线圈。"
    FilterBulletFront = "分流器：子弹送往前方出口。亮＝允许，暗＝禁止。点击切换，设置会保存。"
    FilterBulletLeft = "分流器：子弹送往左侧出口。亮＝允许，暗＝禁止。点击切换，设置会保存。"
    FilterBulletRight = "分流器：子弹送往右侧出口。亮＝允许，暗＝禁止。点击切换，设置会保存。"
    FilterEmpFront = "分流器：EMP导弹部件送往前方出口。亮＝允许，暗＝禁止。点击切换，设置会保存。"
    FilterEmpLeft = "分流器：EMP导弹部件送往左侧出口。亮＝允许，暗＝禁止。点击切换，设置会保存。"
    FilterEmpRight = "分流器：EMP导弹部件送往右侧出口。亮＝允许，暗＝禁止。点击切换，设置会保存。"
}
