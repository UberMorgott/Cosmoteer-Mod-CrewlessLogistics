CrewlessLogistics
{
    HeatCrossingName = "Crewless Logistics 热能/电力交叉"
    HeatCrossingDesc = "橙色热管与蓝色电缆交叉的部件。沿一条轴传热、另一条轴输电，两者互不相连。旋转即可交换方向。可在“能源”和“热能管理”分类中建造。船员无法通过。深色外壳只影响外观，属性与原版热管相同：1000 HP、密度 1，不属于装甲类别，也不吸收 EMP。造价：4 线圈 + 2 钢板。"
    NetworkOff = "电网：关。点击将此设备接入电缆。默认关闭，设置会保存。已储存的能源会保留，设备照常运行，船员仍可运送电池。"
    NetworkOn = "电网：开。点击断开此设备与电缆的连接。设置会保存。每个设备都必须打开自身开关，包括从引擎室接收能源的推进器。超频模式需另行切换。"
    CableName = "Crewless Logistics 电力电缆"
    CableDesc = "带有深色金属外壳的电力电缆，外部屋顶为普通船体外观。四个方向自动连接，只传输整颗电池。相连的电源至少存有一颗电池时，格栅下的绿色玻璃会亮起。不与热管连接，船员无法通过。外壳只影响外观，属性与原版热管相同：1000 HP、密度 1，不属于装甲类别，也不吸收 EMP。造价：4 线圈 + 2 钢板。"
    CrossingName = "Crewless Logistics 船员通道电缆"
    CrossingDesc = "可供船员横穿的电缆，两端设有相对的电力接口。船员可沿垂直于电缆的方向，以正常速度的 80% 穿过。旋转部件可调整方向。只传输整颗电池。相连的电源至少存有一颗电池时，格栅下的绿色玻璃会亮起。不与热管连接。属性与原版热管相同：1000 HP、密度 1，不属于装甲类别，也不吸收 EMP。造价：4 线圈 + 2 钢板。"
    BeltName = "Crewless Logistics 传送带"
    BeltDesc = "以每秒2格的速度在两条车道上运送任意可堆叠资源，每格每条车道最多4个。只从一侧送入时会自动转弯；从直线段侧面汇入的传送带会把物品放到靠近的一条车道。船员可以在上面行走。旋转以设定方向。需要 Yet Another Mod Loader 库，没有它时传送带只是普通地板。花费4钢材 + 2线圈。"
    SplitterName = "Crewless Logistics 传送带分流器"
    SplitterDesc = "1x2。后方两个入口，前方两个出口。每条车道上的物品在两个出口之间轮流分配；一个出口堵塞或缺失时全部送往另一个，因此也能合并两条传送带。车道保持不变。没有过滤器。花费8钢材 + 4线圈。"
    ConnectorName = "Crewless Logistics 传送带连接器"
    ConnectorDesc = "把选定的资源从箭头后方和两侧的格子（多个舱室轮流）移到前方的格子：舱室到传送带、传送带到舱室、舱室到舱室或传送带到传送带。适用于货舱、工厂和武器，从不连接电网。用过滤按钮选择资源；默认的“自动”只移动两侧都能使用的唯一资源，否则不移动；“无”使其停止。不需要能源。花费4钢材 + 2线圈。"
    BeltHeatCrossingName = "Crewless Logistics 传送带/热管交叉"
    BeltHeatCrossingDesc = "直线传送带从热管上方经过：物品沿一个方向移动，热量沿另一个方向传递。旋转以设定传送带方向。不会转弯；从侧面汇入的传送带会把物品放到近侧车道。船员可沿传送带以 80% 速度行走。属性同原版热管交叉：1000 生命值，密度 1。传送带需要 Yet Another Mod Loader 库。花费 4 钢 + 2 线圈。"
    BeltCableCrossingName = "Crewless Logistics 传送带/电缆交叉"
    BeltCableCrossingDesc = "直线传送带从电缆上方经过：物品沿一个方向移动，完整电池沿另一个方向传输；不连接热管。旋转以设定传送带方向。不会转弯；从侧面汇入的传送带会把物品放到近侧车道。船员可沿传送带以 80% 速度行走。属性同原版热管交叉：1000 生命值，密度 1。传送带需要 Yet Another Mod Loader 库。花费 4 钢 + 2 线圈。"
    FilterAuto = "传送带过滤：自动。只通过相邻设施唯一接受的资源，否则不通过任何物品。可选择一种资源、“任意”或“无”。"
    FilterNone = "传送带过滤：无。已停止，不通过任何物品。"
    FilterAny = "传送带过滤：任意资源。"
}
