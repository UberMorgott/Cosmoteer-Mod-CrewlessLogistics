// Splitter item filter (docs/BELTS_DESIGN.md §23). Mode 0 = no filter (default, current behaviour); 1+i = BeltTypes.Ids[i].
// Matching items go to the output priority side (left when output priority is none), every other item to the other side.
Toggle
{
    ToggleID = "morgott.crewless_logistics.belt_splitter_filter"
    Style = Popout
    ShowInEditor = true
    SortOrder = 4
    Choices
    [
        { ChoiceID = "morgott.crewless_logistics.belt_splitter_filter.none"; ButtonToolTipKey = "CrewlessLogistics/SplitterFilterNone"; ButtonSprite { Texture { File = "./Data/gui/cancel.png"; MipLevels = 2; SampleMode = Linear }; Size = [64, 64] } }
        { ChoiceID = "morgott.crewless_logistics.belt_splitter_filter.sulfur"; ButtonToolTipKey = "Resource/Sulfur"; ButtonSprite { Texture { File = "./Data/resources/sulfur/icon.png"; MipLevels = 2; SampleMode = Linear }; Size = [64, 64] } }
        { ChoiceID = "morgott.crewless_logistics.belt_splitter_filter.iron"; ButtonToolTipKey = "Resource/Iron"; ButtonSprite { Texture { File = "./Data/resources/iron/icon.png"; MipLevels = 2; SampleMode = Linear }; Size = [64, 64] } }
        { ChoiceID = "morgott.crewless_logistics.belt_splitter_filter.copper"; ButtonToolTipKey = "Resource/Copper"; ButtonSprite { Texture { File = "./Data/resources/copper/icon.png"; MipLevels = 2; SampleMode = Linear }; Size = [64, 64] } }
