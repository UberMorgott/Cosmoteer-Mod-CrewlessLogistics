// Crewless ammo belts (prototype). Output faces the part's "up"; input is its back.
// Lanes and templates: ammo_belt_common.rules.

Straight : <ammo_belt_common.rules>/BasePart
{
    ID = morgott.crewless_logistics.ammo_belt
    SelectionTypeID = morgott.crewless_logistics.ammo_belt
