// Conveyor belt (docs/BELTS_DESIGN.md §2-§5). Rules declare only vanilla components; the C# belt sim
// (CrewlessLogistics.Belts.dll, Yet Another Mod Loader) moves items. Without the DLL it is an inert walkable floor.
// Rotatable vanilla conveyor body (corridor category, walls, darkness, roof); crew walk at corridor speed (Q6).
Part : <./Data/ships/terran/conveyor/conveyor.rules>/Part
{
    ID = morgott.crewless_logistics.belt
    OtherIDs = []
    NameKey = "CrewlessLogistics/BeltName"
    IconNameKey = "CrewlessLogistics/BeltName"
    DescriptionKey = "CrewlessLogistics/BeltDesc"
    EditorGroup = "Storage"
    EditorGroups = ["Storage", "Power"]
    DontStackInEditorGroups = ["Storage", "Power"]
    EditorParentParts = []
    Resources = [[steel, 4], [coil, 2]]
    SelectionTypeID = morgott.crewless_logistics.belt
    IsFlippable = false
    CrewSpeedFactor { Up = 1; Left = 1; Right = 1; Down = 1 }
    CrewCongestedSpeedFactor { Up = .5; Left = .5; Right = .5; Down = .5 }
    EditorIcon { Texture { File = "assets/belt_icon.png"; SampleMode = Linear }; Size = [32, 32] }
    Components : <./Data/ships/terran/conveyor/conveyor.rules>/Part/Components
    {
        // Static darker plates + direction arrow under the items layer (doodads_low); no crew-conveyor animation.
        Graphics
        {
            Type = Graphics
            Location = [.5, .5]
            Floor
            {
                Layer = "floors"
                DamageLevels
                [
                    { File = "assets/belt.png"; Size = [1, 1] }
                ]
            }
            Roof = &<./Data/ships/terran/corridor/corridor.rules>/Part/Components/Graphics/Roof
        }
        // Never instantiated (both Include* false); only puts the vanilla single-nugget textures into the doodads_low
        // atlas so the C# sim can draw belt items. Order = BeltTypes.Ids (belts/src/NodeState.cs).
        BeltItemSprites
        {
            Type = Sprite
            IncludeWhenUnderConstruction = false
            IncludeWhenNotUnderConstruction = false
            Layer = "doodads_low"
            Location = [.5, .5]
            RandomAtlasSprite
            [
                { File = "./Data/resources/sulfur/sulfur.png"; Size = [1, 1] }
                { File = "./Data/resources/iron/iron.png"; Size = [1, 1] }
                { File = "./Data/resources/copper/copper.png"; Size = [1, 1] }
                { File = "./Data/resources/carbon/carbon.png"; Size = [1, 1] }
                { File = "./Data/resources/gold/gold.png"; Size = [1, 1] }
                { File = "./Data/resources/uranium/uranium.png"; Size = [1, 1] }
                { File = "./Data/resources/diamond/diamond.png"; Size = [1, 1] }
                { File = "./Data/resources/hyperium/hyperium1-1.png"; Size = [1, 1] }
                { File = "./Data/resources/steel/steel1.png"; Size = [1, 1] }
                { File = "./Data/resources/coil/coil1.png"; Size = [1, 1] }
                { File = "./Data/resources/coil2/coil2_1.png"; Size = [1, 1] }
                { File = "./Data/resources/tristeel/tristeel1.png"; Size = [1, 1] }
                { File = "./Data/resources/tritanium/tritanium.png"; Size = [1, 1] }
                { File = "./Data/resources/processor/processor.png"; Size = [1, 1] }
                { File = "./Data/resources/enriched_uranium/enriched_uranium.png"; Size = [1, 1] }
                { File = "./Data/resources/bullet/bullet1.png"; Size = [1, 1] }
                { File = "./Data/resources/missile_part_he/missile_part_he1.png"; Size = [1, 1] }
                { File = "./Data/resources/missile_part_emp/missile_part_emp1.png"; Size = [1, 1] }
                { File = "./Data/resources/missile_part_nuke/missile_part_nuke.png"; Size = [1, 1] }
                { File = "./Data/resources/missile_part_thermal/missile_part_thermal1.png"; Size = [1, 1] }
                { File = "./Data/resources/mine_part/mine_part1.png"; Size = [1, 1] }
            ]
        }
        // Never instantiated, like BeltItemSprites: animated belt surfaces in the turrets atlas (between part floors and
        // items, docs/BELTS_DESIGN.md §21). Order = belts/src/BeltRenderState.cs Variant. 16 frames = one tile of travel
        // at 2 tiles/s; frames are mechanical remaps of the straight Codex master (tools/belt-sprites bakeAnim).
        BeltSurfaceSprites
        {
            Type = Sprite
            IncludeWhenUnderConstruction = false
            IncludeWhenNotUnderConstruction = false
            Layer = "turrets"
            Location = [.5, .5]
            RandomAtlasSprite
            [
                { AnimationFiles [ "assets/belt_anim/straight_00.png", "assets/belt_anim/straight_01.png", "assets/belt_anim/straight_02.png", "assets/belt_anim/straight_03.png", "assets/belt_anim/straight_04.png", "assets/belt_anim/straight_05.png", "assets/belt_anim/straight_06.png", "assets/belt_anim/straight_07.png", "assets/belt_anim/straight_08.png", "assets/belt_anim/straight_09.png", "assets/belt_anim/straight_10.png", "assets/belt_anim/straight_11.png", "assets/belt_anim/straight_12.png", "assets/belt_anim/straight_13.png", "assets/belt_anim/straight_14.png", "assets/belt_anim/straight_15.png" ]; Size = [1, 1]; AnimationInterval = .03125; AnimationStartTime = Zero }
                { AnimationFiles [ "assets/belt_anim/join_l_00.png", "assets/belt_anim/join_l_01.png", "assets/belt_anim/join_l_02.png", "assets/belt_anim/join_l_03.png", "assets/belt_anim/join_l_04.png", "assets/belt_anim/join_l_05.png", "assets/belt_anim/join_l_06.png", "assets/belt_anim/join_l_07.png", "assets/belt_anim/join_l_08.png", "assets/belt_anim/join_l_09.png", "assets/belt_anim/join_l_10.png", "assets/belt_anim/join_l_11.png", "assets/belt_anim/join_l_12.png", "assets/belt_anim/join_l_13.png", "assets/belt_anim/join_l_14.png", "assets/belt_anim/join_l_15.png" ]; Size = [1, 1]; AnimationInterval = .03125; AnimationStartTime = Zero }
                { AnimationFiles [ "assets/belt_anim/join_r_00.png", "assets/belt_anim/join_r_01.png", "assets/belt_anim/join_r_02.png", "assets/belt_anim/join_r_03.png", "assets/belt_anim/join_r_04.png", "assets/belt_anim/join_r_05.png", "assets/belt_anim/join_r_06.png", "assets/belt_anim/join_r_07.png", "assets/belt_anim/join_r_08.png", "assets/belt_anim/join_r_09.png", "assets/belt_anim/join_r_10.png", "assets/belt_anim/join_r_11.png", "assets/belt_anim/join_r_12.png", "assets/belt_anim/join_r_13.png", "assets/belt_anim/join_r_14.png", "assets/belt_anim/join_r_15.png" ]; Size = [1, 1]; AnimationInterval = .03125; AnimationStartTime = Zero }
                { AnimationFiles [ "assets/belt_anim/join_lr_00.png", "assets/belt_anim/join_lr_01.png", "assets/belt_anim/join_lr_02.png", "assets/belt_anim/join_lr_03.png", "assets/belt_anim/join_lr_04.png", "assets/belt_anim/join_lr_05.png", "assets/belt_anim/join_lr_06.png", "assets/belt_anim/join_lr_07.png", "assets/belt_anim/join_lr_08.png", "assets/belt_anim/join_lr_09.png", "assets/belt_anim/join_lr_10.png", "assets/belt_anim/join_lr_11.png", "assets/belt_anim/join_lr_12.png", "assets/belt_anim/join_lr_13.png", "assets/belt_anim/join_lr_14.png", "assets/belt_anim/join_lr_15.png" ]; Size = [1, 1]; AnimationInterval = .03125; AnimationStartTime = Zero }
                { AnimationFiles [ "assets/belt_anim/curve_00.png", "assets/belt_anim/curve_01.png", "assets/belt_anim/curve_02.png", "assets/belt_anim/curve_03.png", "assets/belt_anim/curve_04.png", "assets/belt_anim/curve_05.png", "assets/belt_anim/curve_06.png", "assets/belt_anim/curve_07.png", "assets/belt_anim/curve_08.png", "assets/belt_anim/curve_09.png", "assets/belt_anim/curve_10.png", "assets/belt_anim/curve_11.png", "assets/belt_anim/curve_12.png", "assets/belt_anim/curve_13.png", "assets/belt_anim/curve_14.png", "assets/belt_anim/curve_15.png" ]; Size = [1, 1]; AnimationInterval = .03125; AnimationStartTime = Zero }
                { AnimationFiles [ "assets/belt_anim/heat_crossing_00.png", "assets/belt_anim/heat_crossing_01.png", "assets/belt_anim/heat_crossing_02.png", "assets/belt_anim/heat_crossing_03.png", "assets/belt_anim/heat_crossing_04.png", "assets/belt_anim/heat_crossing_05.png", "assets/belt_anim/heat_crossing_06.png", "assets/belt_anim/heat_crossing_07.png", "assets/belt_anim/heat_crossing_08.png", "assets/belt_anim/heat_crossing_09.png", "assets/belt_anim/heat_crossing_10.png", "assets/belt_anim/heat_crossing_11.png", "assets/belt_anim/heat_crossing_12.png", "assets/belt_anim/heat_crossing_13.png", "assets/belt_anim/heat_crossing_14.png", "assets/belt_anim/heat_crossing_15.png" ]; Size = [1, 1]; AnimationInterval = .03125; AnimationStartTime = Zero }
                { AnimationFiles [ "assets/belt_anim/cable_crossing_00.png", "assets/belt_anim/cable_crossing_01.png", "assets/belt_anim/cable_crossing_02.png", "assets/belt_anim/cable_crossing_03.png", "assets/belt_anim/cable_crossing_04.png", "assets/belt_anim/cable_crossing_05.png", "assets/belt_anim/cable_crossing_06.png", "assets/belt_anim/cable_crossing_07.png", "assets/belt_anim/cable_crossing_08.png", "assets/belt_anim/cable_crossing_09.png", "assets/belt_anim/cable_crossing_10.png", "assets/belt_anim/cable_crossing_11.png", "assets/belt_anim/cable_crossing_12.png", "assets/belt_anim/cable_crossing_13.png", "assets/belt_anim/cable_crossing_14.png", "assets/belt_anim/cable_crossing_15.png" ]; Size = [1, 1]; AnimationInterval = .03125; AnimationStartTime = Zero }
            ]
        }
        // Never instantiated: activity lamp overlays (part-sized, glow only) for the additive lights_add layer; C# shows
        // one for a few ticks after an item passes (§21). Order: connector, splitter output 0, splitter output 1.
        BeltLampSprites
        {
            Type = Sprite
            IncludeWhenUnderConstruction = false
            IncludeWhenNotUnderConstruction = false
            Layer = "lights_add"
            Location = [.5, .5]
            RandomAtlasSprite
            [
                { File = "assets/belt_connector_lamp.png"; Size = [1, 1] }
                { File = "assets/belt_splitter_lamp_0.png"; Size = [2, 1] }
                { File = "assets/belt_splitter_lamp_1.png"; Size = [2, 1] }
            ]
        }
    }
}
