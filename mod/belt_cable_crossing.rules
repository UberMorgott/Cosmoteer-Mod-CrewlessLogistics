// Straight conveyor belt over an electrical cable (docs/BELTS_DESIGN.md §19). Same body as cable_crossing.rules (vanilla
// heat pipe crossing: stats, Left/Right doors, crew speed .8) with our electric ports on Up/Down; the belt runs
// Left/Right (C# front = part cell (1, 0), BeltState.IsCrossing) and crew walk along it. The belt is drawn on top as the
// floor and the cable shows at the Up/Down edges entering tunnels under it, so nothing covers the items.
Part : <./Data/ships/terran/heat_pipe_crossing/heat_pipe_crossing.rules>/Part
{
    ID = morgott.crewless_logistics.belt_cable_crossing
    OtherIDs = []
    TypeCategories = [crewless_logistics]
    NameKey = "CrewlessLogistics/BeltCableCrossingName"
    IconNameKey = "CrewlessLogistics/BeltCableCrossingName"
    DescriptionKey = "CrewlessLogistics/BeltCableCrossingDesc"
    EditorGroup = "Storage"
    EditorGroups = ["Storage", "Power"]
    DontStackInEditorGroups = ["Storage", "Power"]
    EditorParentParts = []
    SelectionTypeID = morgott.crewless_logistics.belt_cable_crossing
    IsFlippable = false
    EditorIcon { Texture { File = "assets/belt_cable_crossing_icon.png"; SampleMode = Linear }; Size = [32, 32] }
    Components : <cable_graphics.rules>/CommonComponents
    {
        IsOperational : <./Data/ships/terran/heat_pipe_crossing/heat_pipe_crossing.rules>/Part/Components/IsOperational {}
        CrewlessLogisticsNode { Type = NetworkBasicNode; IncludeInPhysical = true }
        CrewlessLogisticsBlueprintNode { Type = NetworkBasicNode; IncludeInBlueprints = true }
        Port_Up : <common.rules>/CableElectricPort { Direction = Up }
        Port_Down : Port_Up { Direction = Down }
        DestroyedEffects : <./Data/ships/terran/heat_pipe_crossing/heat_pipe_crossing.rules>/Part/Components/DestroyedEffects {}
        Dont_Draw_Pipe_Connector_Into_This_Part { Type = Graphics }
        Graphics
        {
            Type = Graphics
            Location = [.5, .5]
            Floor { Layer = "floors"; DamageLevels [ { File = "assets/belt_cable_crossing.png"; Size = [1, 1] } ] }
            Walls : <./Data/ships/terran/heat_pipe_crossing/heat_pipe_crossing.rules>/Part/Components/Graphics/Walls {}
            Roof = &<./Data/ships/terran/corridor/corridor.rules>/Part/Components/Graphics/Roof
        }
        Blueprints : <./Data/ships/terran/heat_pipe_crossing/heat_pipe_crossing.rules>/Part/Components/Blueprints
        {
            File = "assets/belt_cable_crossing_blueprint.png"
        }
    }
}
