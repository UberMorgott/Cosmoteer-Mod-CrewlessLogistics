// Connector resource filter (docs/BELTS_DESIGN.md §7). Choice index = C# filter (BeltTypes.FilterFromMode):
// 0 auto (default: the single type the neighbours allow, else nothing), 1 any, then BeltTypes.Ids in order, then 23 none (explicit stop,
// never auto-filled; docs/BELTS_DESIGN.md §22). Tooltips/icons of resources and auto/none are vanilla.
Toggle
{
    ToggleID = "morgott.crewless_logistics.belt_filter"
    Style = Popout
    ShowInEditor = true
    SortOrder = 2
    Choices
    [
        { ChoiceID = "morgott.crewless_logistics.belt_filter.auto"; ButtonToolTipKey = "CrewlessLogistics/FilterAuto"; ButtonSprite { Texture { File = "./Data/gui/game/parts/toggle_fire_auto.png"; MipLevels = 2; SampleMode = Linear }; Size = [64, 64] } }
