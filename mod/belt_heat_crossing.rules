// Straight conveyor belt over a heat pipe (docs/BELTS_DESIGN.md §19). The vanilla heat pipe crossing keeps its thermal
// Port_Up/Port_Down, nodes, pipe connectors, stats, Left/Right doors and crew speed .8; the belt runs Left/Right (C#
// front = part cell (1, 0), BeltState.IsCrossing) and crew walk along it. Only the art is replaced: the belt is drawn
// on top as the floor and the pipe shows at the Up/Down edges entering tunnels under it, so nothing covers the items.
Part : <./Data/ships/terran/heat_pipe_crossing/heat_pipe_crossing.rules>/Part
{
    ID = morgott.crewless_logistics.belt_heat_crossing
    OtherIDs = []
    NameKey = "CrewlessLogistics/BeltHeatCrossingName"
    IconNameKey = "CrewlessLogistics/BeltHeatCrossingName"
    DescriptionKey = "CrewlessLogistics/BeltHeatCrossingDesc"
    EditorGroup = "Storage"
    EditorGroups = ["Storage", "Power"]
    DontStackInEditorGroups = ["Storage", "Power"]
    EditorParentParts = []
    SelectionTypeID = morgott.crewless_logistics.belt_heat_crossing
    IsFlippable = false
    EditorIcon { Texture { File = "assets/belt_heat_crossing_icon.png"; SampleMode = Linear }; Size = [32, 32] }
    Components : <./Data/ships/terran/heat_pipe_crossing/heat_pipe_crossing.rules>/Part/Components
    {
        // Fresh groups: no vanilla pipe cylinder (doodads_high), darkness overlay or heat glow above the belt items.
        Graphics
        {
            Type = Graphics
            Location = [.5, .5]
            Floor { Layer = "floors"; DamageLevels [ { File = "assets/belt_heat_crossing.png"; Size = [1, 1] } ] }
            Walls : <./Data/ships/terran/heat_pipe_crossing/heat_pipe_crossing.rules>/Part/Components/Graphics/Walls {}
            Roof = &<./Data/ships/terran/corridor/corridor.rules>/Part/Components/Graphics/Roof
        }
        Darkness_Graphics { Type = Graphics }
        HeatGlow_Graphics { Type = Graphics }
        Blueprints : <./Data/ships/terran/heat_pipe_crossing/heat_pipe_crossing.rules>/Part/Components/Blueprints
        {
            File = "assets/belt_heat_crossing_blueprint.png"
        }
    }
}
