ID = morgott.crewless_logistics
Name = "Crewless Logistics"
Version = 0.4.0
CompatibleGameVersions = ["0.30.5"]
ModifiesGameplay = true
ModifiesMultiplayer = true
// Yet Another Mod Loader (Harmony) loads CrewlessLogistics.Belts.dll; the energy network itself stays rules-only.
Dependencies = ["3577650065"]
Author = "Morgott"
Logo = "logo.png"
Description = "EN: Requires Yet Another Mod Loader (3577650065) installed via its Installer.bat; trust the Crewless Logistics library in the Mods list.\nReport bugs only on GitHub using the Bug report template, not in Workshop comments: https://github.com/UberMorgott/Cosmoteer-Mod-CrewlessLogistics/issues\nCrewless electrical network: cables carry whole batteries from reactors and Power Capacitors to powered devices. Crew delivery still works. Includes electrical cable (blocks crew, four connections, plain hull roof), crew crossing (walk across at 80% speed) and heat/electric crossover (one axis each; rotate to swap; blocks crew). All three have vanilla Heat Pipe stats: 1000 HP, density 1, no armor category or EMP absorption. Each costs 4 coils + 2 steel; dark plating is cosmetic. Electrical Network switches on every reactor, capacitor and powered device are off by default; settings are saved. Reactors supply first. Capacitors supply only while no reachable reactor has a whole battery, and charge through the network only from reactors, after devices. Engine Rooms receive power and pass batteries to the engines and thrusters they buff: enable the room's network and power distribution switches, and each recipient's network switch. Supports all vanilla powered devices plus parts from Diagonal Thruster Plus and Diagonal Cockpits, only if installed. Resource logistics (Storage and Power tabs): crew-walkable two-lane conveyor belts that curve automatically and accept side-loading, a 1x2 splitter, and a directional connector that moves one chosen resource between a room, a belt or another room (filter off by default), and straight belt crossings over a Heat Pipe or an electrical cable (crew walk along the belt at 80% speed). Multiplayer: same mod, loader and game versions for everyone.\n\nRU: Нужен Yet Another Mod Loader (3577650065), установленный через его Installer.bat; разрешите библиотеку Crewless Logistics в списке модов.\nСообщайте об ошибках только на GitHub по шаблону Bug report, не в комментариях Мастерской: https://github.com/UberMorgott/Cosmoteer-Mod-CrewlessLogistics/issues\nЭлектросеть без экипажа: кабели передают целые батареи от реакторов и силовых накопителей к устройствам. Обычная доставка экипажем тоже работает. Есть электрический кабель (экипаж не проходит, четыре подключения, снаружи обычная обшивка), проходной кабель (проход поперёк со скоростью 80%) и пересечение тепла и электричества (по разным осям; поворот меняет их местами; экипаж не проходит). У всех трёх характеристики обычного теплопередатчика: прочность 1000, плотность 1, без категории брони и поглощения ЭМИ. Каждая деталь стоит 4 спирали + 2 стали. Тёмные панели — только внешний вид. Переключатель «Электросеть» есть на каждом реакторе, накопителе и устройстве; по умолчанию выключен, положение сохраняется. Сначала энергию отдают реакторы. Накопители отдают её, только когда ни у одного доступного реактора нет целой батареи, а по сети заряжаются только от реакторов, после снабжения устройств. Машинные отсеки получают энергию и передают батареи двигателям, которые они усиливают: включите в отсеке сеть и распределение энергии, у каждого двигателя — свою сеть. Поддерживаются все устройства базовой игры, которым нужна энергия, и детали Diagonal Thruster Plus и Diagonal Cockpits, только если эти моды установлены. Логистика ресурсов (вкладки «Хранение» и «Энергия»): двухполосные конвейеры, по которым может ходить экипаж, сами поворачивают и принимают боковую подачу; разделитель 1x2; направленный соединитель переносит один выбранный ресурс между отсеком, конвейером или другим отсеком (фильтр по умолчанию выключен), а также прямые переезды конвейера над теплопередатчиком или электрокабелем (экипаж ходит вдоль ленты на 80% скорости). Для сетевой игры у всех должны совпадать версии мода, загрузчика и игры."
StringsFolder = "strings"

// Generated device AddBase actions come first; the list below is appended natively.
Actions : <generated.actions.rules>/Actions
[
    {
        Action = AddMany
        AddTo = "<ships/terran/terran.rules>/Terran/RenderLayers"
        ManyToAdd
        [
            &<cable_material.rules>/ThermalLayer
        ]
    }
    {
        Action = Add
        AddTo = "<gui/game/parts/part_toggles.rules>/PartToggles"
        ToAdd = &<network_toggle.rules>/Toggle
    }
    {
        Action = Add
        AddTo = "<gui/game/parts/part_toggles.rules>/PartToggles"
        ToAdd = &<belt_filter_toggle.rules>/Toggle
    }
    {
        Action = AddMany
        AddTo = "<ships/terran/terran.rules>/Terran/Parts"
        ManyToAdd
        [
            &<cable.rules>/Part
            &<cable_crossing.rules>/Part
            &<cable_heat_crossing.rules>/Part
            &<belt.rules>/Part
            &<belt_splitter.rules>/Part
            &<belt_connector.rules>/Part
            &<belt_heat_crossing.rules>/Part
            &<belt_cable_crossing.rules>/Part
        ]
    }
    {
        Action = Overrides
        OverrideIn = "<gui/game/parts/networks/part_networks.rules>/OverlayIcons"
        Overrides
        {
            CrewlessLogisticsElectricPort : <./Data/gui/game/parts/networks/part_networks.rules>/OverlayIcons/ThermalPort
            {
                Sprite : ^/0/Sprite { VertexColor = [110, 255, 45, 255] }
            }
            CrewlessLogisticsElectricDot : <./Data/gui/game/parts/networks/part_networks.rules>/OverlayIcons/ThermalDot
            {
                // The thermal circle texture is already orange; use a neutral vanilla dot.
                Sprite : ^/0/Sprite
                {
                    File = "./Data/gui/dot.png"
                    VertexColor = [110, 255, 45, 255]
                    Size = [0.3, 0.3]
                }
            }
        }
    }
]
